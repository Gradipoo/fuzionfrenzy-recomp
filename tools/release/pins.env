# Pinned player toolchain. tools/release/fetch-toolchain.sh sources this file.
# Each URL was checked against the upstream release. Do not invent assets.

# CMake 4.4.5 binary archives. The script keeps share/ next to bin/ so cmake can find its modules.
CMAKE_VERSION=4.4.5
CMAKE_LINUX_URL=https://github.com/Kitware/CMake/releases/download/v4.4.5/cmake-4.4.5-linux-x86_64.tar.gz
CMAKE_DARWIN_URL=https://github.com/Kitware/CMake/releases/download/v4.4.5/cmake-4.4.5-macos-universal.tar.gz
CMAKE_WINDOWS_URL=https://github.com/Kitware/CMake/releases/download/v4.4.5/cmake-4.4.5-windows-x86_64.zip

# Ninja 1.13.2. Each zip is one binary.
NINJA_VERSION=1.13.2
NINJA_LINUX_URL=https://github.com/ninja-build/ninja/releases/download/v1.13.2/ninja-linux.zip
NINJA_DARWIN_URL=https://github.com/ninja-build/ninja/releases/download/v1.13.2/ninja-mac.zip
NINJA_WINDOWS_URL=https://github.com/ninja-build/ninja/releases/download/v1.13.2/ninja-win.zip

# LLVM 23.1.5. Linux publishes one official tarball, built on Ubuntu 22.04.
# That is the oldest glibc this version still ships. Windows is the MSVC clang-cl archive.
LLVM_VERSION=23.1.5
LLVM_LINUX_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.5/LLVM-23.1.5-Linux-X64.tar.xz
LLVM_WINDOWS_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.5/clang+llvm-23.1.5-x86_64-pc-windows-msvc.tar.xz

# Vulkan SDK 1.4.363 matches MoltenVK 1.4.2 on the Mac build.
VULKAN_SDK_TAG=vulkan-sdk-1.4.363.0
VULKAN_HEADERS_URL=https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/vulkan-sdk-1.4.363.0.tar.gz
VULKAN_LOADER_URL=https://github.com/KhronosGroup/Vulkan-Loader/archive/refs/tags/vulkan-sdk-1.4.363.0.tar.gz

# glslang 16.6.0. Same version the Mac build uses. Built static from the tag archive.
GLSLANG_TAG=16.6.0
GLSLANG_URL=https://github.com/KhronosGroup/glslang/archive/refs/tags/16.6.0.tar.gz

# zlib 1.4 static library.
ZLIB_VERSION=1.4
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.4/zlib-1.4.tar.gz

# libusb 1.0.30. Mac only. The release tarball includes configure.
LIBUSB_VERSION=1.0.30
LIBUSB_URL=https://github.com/libusb/libusb/releases/download/v1.0.30/libusb-1.0.30.tar.bz2

# MoltenVK 1.4.2 macOS dylib. The ICD library_path is rewritten to a relative path.
MOLTENVK_VERSION=1.4.2
MOLTENVK_MACOS_URL=https://github.com/KhronosGroup/MoltenVK/releases/download/v1.4.2/MoltenVK-macos.tar

# xwin 0.10.0 Windows CRT/SDK downloader. The archive contains xwin.exe.
XWIN_VERSION=0.10.0
XWIN_WINDOWS_URL=https://github.com/Jake-Shadle/xwin/releases/download/0.10.0/xwin-0.10.0-x86_64-pc-windows-msvc.tar.gz

# Python 3.15.2. Windows official embeddable amd64. Linux install_only from python-build-standalone.
# Mac does not bundle Python.
PYTHON_VERSION=3.15.2
PYTHON_WINDOWS_URL=https://www.python.org/ftp/python/3.15.2/python-3.15.2-embed-amd64.zip
PYTHON_LINUX_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.15.2+20261110-x86_64-unknown-linux-gnu-install_only.tar.gz

# Third-party tags match sdk/cmake/XbeRecomp.cmake.
SDL_TAG=release-3.4.16
SDL_URL=https://github.com/libsdl-org/SDL/archive/refs/tags/release-3.4.16.tar.gz
IMGUI_TAG=v1.91.9b
IMGUI_URL=https://github.com/ocornut/imgui/archive/refs/tags/v1.91.9b.tar.gz
TOMLPLUSPLUS_TAG=v3.4.0
TOMLPLUSPLUS_URL=https://github.com/marzer/tomlplusplus/archive/refs/tags/v3.4.0.tar.gz
# A GitHub archive omits the zycore submodule. The script clones the tag with submodules.
ZYDIS_TAG=v4.1.1
ZYDIS_GIT_URL=https://github.com/zyantific/zydis.git
