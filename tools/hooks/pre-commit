#!/bin/sh
# Refuse commits that touch game data, recompiled guest code, or build output.
#
# Install, from the repository root (pick one):
#   git config core.hooksPath tools/hooks
#   ln -sfn ../../tools/hooks/pre-commit .git/hooks/pre-commit
#
# core.hooksPath replaces every other hook in .git/hooks. This repository
# ships no other hooks. The path rules live in forbid-game-paths.sh so CI
# checks the same list.
set -eu

cd "$(git rev-parse --show-toplevel)"
files=$(git diff --cached --name-only --diff-filter=ACMRDT)
if [ -z "$files" ]; then
    exit 0
fi
# shellcheck disable=SC2086
printf '%s\n' $files | tools/hooks/forbid-game-paths.sh
