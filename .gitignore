# build
/out/
/build/
*.zip
*.pdb
*.exe
*.obj
*.o

# recompiled code, derived from the game
/generated/

# user's own game files: the disc image, its default.xbe and everything extracted from
# it into assets/, plus the 4k movie assets regenerated from them by tools/upscale_movies.py
/assets/
/assets/movies_4k/
*.iso
*.xiso
*.xbe
*.dmp
*.d3dcap
*.dSYM
*.metallib

# downloaded media tools; tools/upscale_movies.py itself stays tracked
/tools/bin/

# locally installed build toolchain
/.toolchain/

# Determinism harness output. Pad logs, RAM hashes, and desync dumps are derived from a run of the game.
det-logs/
det-desync/
det-snaps/
*.detlog
*.pads
*.ffsnap
desync_*.txt
frame_*_*.bin

# Reverse-engineering workspace. The Ghidra project, decompiler exports, symbol
# dumps, the Unicorn venv, and the oracle binary are derived from the local XBE.
# tools/re/ holds the scripts we wrote and stays tracked.
/re/

# runtime files
settings.toml
shadercache/
/logs/
/hdd/
/CrashDumps/

# editors
.vs/
.vscode/
.idea/
.DS_Store

# Local agent notes. Machine state stays out of the clone.
/NOTES.md

# Local temporary folder
.local
__pycache__/

# Release artifacts: built by release.sh / release.bat, attached to a GitHub
# release, never committed.
/FuzionFrenzy-linux-x64.tar.zst
/FuzionFrenzy-win64.zip
/FuzionFrenzy.zip

# macOS launcher product. The .app and .dmg are built locally. The disk image
# must not be committed: a shipped game binary would be game-derived, and the
# launcher is supposed to compile that binary on the player's Mac.
/macos/launcher/dist/
*.dmg
