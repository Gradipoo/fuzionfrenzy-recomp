+// XBE_LOCKSTEP_NET
+namespace {
+net::Report ReportOf(const Sample& s) {
+    net::Report r;
+    r.connected = s.connected ? 1 : 0;
+    r.buttons = s.buttons;
+    std::memcpy(r.analog, s.analog, 8);
+    r.lx = s.lx;
+    r.ly = s.ly;
+    r.rx = s.rx;
+    r.ry = s.ry;
+    return r;
+}
+
+input::Pad PadOf(const net::Report& r) {
+    Sample s;
+    s.connected = r.connected != 0;
+    s.buttons = r.buttons;
+    std::memcpy(s.analog, r.analog, 8);
+    s.lx = r.lx;
+    s.ly = r.ly;
+    s.rx = r.rx;
+    s.ry = r.ry;
+    return s.Pad();
+}
+}  // namespace
+
+net::Session& LockstepSession() {
+    static net::Session* s = nullptr;
+    if (!s) {
+        net::Config cfg;
+        cfg.bind = C().lock_bind;
+        cfg.peer = C().lock_peer;
+        cfg.seat = C().lock_seat;
+        cfg.delay = C().lock_delay;
+        cfg.timeout_ms = C().lock_timeout_ms;
+        cfg.hello_ms = C().lock_hello_ms;
+        cfg.seed = C().seed;
+        const app::Settings& st = app::Get();
+        cfg.width = st.width;
+        cfg.height = st.height;
+        cfg.ultrawide = st.ultrawide ? 1 : 0;
+        s = new net::Session(cfg);
+    }
+    return *s;
 }
 
+void LockstepStop(const net::Result& r, uint64_t frame) {
+    if (r.fail == net::Fail::None) return;
+    if (r.fail == net::Fail::Desync) {
+        std::vector<Exc> none;
+        ReportDesync(r.frame, "total", r.local_hash, r.remote_hash, none);
+    }
+    LOGE("det: lockstep %s at frame %llu", r.why ? r.why : "failed",
+         (unsigned long long)(r.frame ? r.frame : frame));
+    kernel::Shutdown(2);
+}
+
+void LockstepNote(uint64_t frame, uint64_t total) { LockstepStop(LockstepSession().NoteHash(frame, total), frame); }
+
+void LockstepFinish(uint64_t frame) { LockstepStop(LockstepSession().Drain(frame), frame); }
+
+uint64_t g_agreed_frame = ~uint64_t{0};
+net::Report g_agreed[4];
+
+void LockstepApply(int port, input::Pad& pad) {
+    uint64_t frame = g_frame.load(std::memory_order_relaxed);
+    if (g_agreed_frame != frame) {
+        net::Report local;
+        if (C().lock_seat == 2 && C().port2_mash) local = ReportOf(MashPort2(frame));
+        else if (C().replay) local = ReportOf(ReplayAt(frame, 0));
+        else if (port == 0) local = ReportOf(Sample(pad));
+        net::Result agreed = LockstepSession().Agree(frame, local);
+        LockstepStop(agreed, frame);
+        for (int i = 0; i < 4; i++) g_agreed[i] = agreed.pad[i];
+        g_agreed_frame = frame;
+    }
+    pad = PadOf(g_agreed[port]);
+}
