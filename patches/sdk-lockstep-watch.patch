+        if (kr != KERN_SUCCESS) {
+            LOGR("det: watch mach port %d", kr);
+            return;
+        }
+        kr = mach_port_insert_right(mach_task_self(), g_exc_port, g_exc_port, MACH_MSG_TYPE_MAKE_SEND);
+        if (kr != KERN_SUCCESS) {
+            LOGR("det: watch mach right %d", kr);
+            return;
+        }
