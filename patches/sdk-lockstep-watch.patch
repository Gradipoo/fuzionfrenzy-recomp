+
+void NoteCompletion(uint32_t ret, uint32_t a, uint32_t ca, uint32_t ca2, uint32_t b, uint32_t cb, uint32_t cb2) {
+    if (!WatchArmed()) return;
+    static std::atomic<int> n{0};
+    int i = n.fetch_add(1, std::memory_order_relaxed);
+    if (i >= 80) return;
+    WBuf buf;
+    buf.lit("compl n="); buf.dec(uint64_t(i + 1));
+    buf.lit(" tid="); buf.dec(NoteTid());
+    buf.lit(" frame="); buf.dec(g_frame.load(std::memory_order_relaxed));
+    buf.lit(" tick="); buf.dec(g_time.load(std::memory_order_relaxed));
+    buf.lit(" ret="); buf.hex(ret, 8);
+    buf.lit(" a="); buf.hex(a, 8);
+    buf.lit(" ca="); buf.hex(ca, 8);
+    buf.lit(" ca2="); buf.hex(ca2, 8);
+    buf.lit(" b="); buf.hex(b, 8);
+    buf.lit(" cb="); buf.hex(cb, 8);
+    buf.lit(" cb2="); buf.hex(cb2, 8);
+    buf.emit();
+}
+
+void NoteDpc(const char* where, uint32_t routine) {
+    if (!WatchArmed() || !where) return;
+    static std::atomic<int> n{0};
+    int i = n.fetch_add(1, std::memory_order_relaxed);
+    if (i >= 80) return;
+    WBuf buf;
+    buf.lit("dpc n="); buf.dec(uint64_t(i + 1));
+    buf.lit(" "); buf.lit(where);
+    buf.lit(" frame="); buf.dec(g_frame.load(std::memory_order_relaxed));
+    buf.lit(" tick="); buf.dec(g_time.load(std::memory_order_relaxed));
+    buf.lit(" routine="); buf.hex(routine, 8);
+    buf.emit();
+}
+
+void NoteTimer(uint32_t dpc, int32_t period_ms, uint32_t due_lo) {
+    if (!WatchArmed()) return;
+    static std::atomic<int> n{0};
+    int i = n.fetch_add(1, std::memory_order_relaxed);
+    if (i >= 40) return;
+    WBuf buf;
+    buf.lit("timer n="); buf.dec(uint64_t(i + 1));
+    buf.lit(" frame="); buf.dec(g_frame.load(std::memory_order_relaxed));
+    buf.lit(" tick="); buf.dec(g_time.load(std::memory_order_relaxed));
+    buf.lit(" dpc="); buf.hex(dpc, 8);
+    buf.lit(" period="); buf.dec(uint64_t(uint32_t(period_ms)));
+    buf.lit(" due="); buf.hex(due_lo, 8);
+    buf.emit();
+}
