+void WatchStart() {
+#if defined(__linux__) && (defined(__aarch64__) || defined(__x86_64__)) || defined(__APPLE__)
+    static std::once_flag once;
+    std::call_once(once, [] {
+        const char* env = std::getenv("FUZION_WATCH_VA");
+        if (!env || !env[0]) return;
+        const char* p = env;
+        if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) p += 2;
+        char* end = nullptr;
+        unsigned long va = std::strtoul(p, &end, 16);
+        if (!va || va > 0xfffffffful) {
+            LOGR("det: watch ignored FUZION_WATCH_VA=%s", env);
+            return;
+        }
+        void* host = kernel::HostPtr(uint32_t(va));
+        g_watch_va.store(uint32_t(va), std::memory_order_relaxed);
