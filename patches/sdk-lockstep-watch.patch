+        // Nothing is armed yet, so a watch cannot fire before the server receives.
+        g_watch_state.store(2, std::memory_order_release);
+        std::thread(WatchServer).detach();
+        while (!g_server_ready.load(std::memory_order_acquire)) std::this_thread::yield();
+        ScanMach();
+#endif
+        // The page may not be committed yet. Reading it here faults. Hits log the value.
+        LOGR("det: watch va %08lx host %p", va, host);
