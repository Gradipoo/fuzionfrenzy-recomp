+    const char* path = C().replay;
+    if (!path) return;
+    std::ifstream in(path);
+    if (!in) {
+        LOGE("det: replay file missing: %s", path);
+        kernel::Shutdown(1);
+    }
+    auto store = [](unsigned frame, int port, unsigned connected, unsigned buttons, int lx, int ly, int rx, int ry,
+                    const unsigned analog[8]) {
+        if (port < 1 || port > 4) return;
+        size_t need = (size_t(frame) + 1) * kPorts;
+        if (g_replay.size() < need) g_replay.resize(need);
+        Sample& s = g_replay[size_t(frame) * kPorts + (port - 1)];
+        s.connected = connected != 0;
+        s.buttons = uint16_t(buttons);
+        s.lx = int16_t(lx);
+        s.ly = int16_t(ly);
+        s.rx = int16_t(rx);
+        s.ry = int16_t(ry);
+        for (int i = 0; i < 8; i++) s.analog[i] = uint8_t(analog[i]);
+    };
+    std::string line;
+    while (std::getline(in, line)) {
+        if (line.empty() || line[0] == '#') continue;
+        if (line.find('|') != std::string::npos) {
+            unsigned frame = 0;
+            if (std::sscanf(line.c_str(), "%u", &frame) != 1) continue;
+            size_t bar = 0;
+            int port = 1;
+            while (port <= 4) {
+                bar = line.find('|', bar);
+                if (bar == std::string::npos) break;
+                const char* p = line.c_str() + bar + 1;
+                unsigned connected = 0, buttons = 0;
+                int lx = 0, ly = 0, rx = 0, ry = 0;
+                unsigned analog[8] = {};
+                int n = std::sscanf(p, "%u,%x,%d,%d,%d,%d,%x,%x,%x,%x,%x,%x,%x,%x", &connected, &buttons, &lx, &ly, &rx,
+                                    &ry, &analog[0], &analog[1], &analog[2], &analog[3], &analog[4], &analog[5],
+                                    &analog[6], &analog[7]);
+                if (n == 14) store(frame, port, connected, buttons, lx, ly, rx, ry, analog);
+                port++;
+                bar++;
+            }
+            continue;
+        }
+        unsigned frame = 0, port = 0, connected = 0, buttons = 0;
+        int lx = 0, ly = 0, rx = 0, ry = 0;
+        unsigned analog[8] = {};
+        int n = std::sscanf(line.c_str(), "%u %u %u %x %d %d %d %d %x %x %x %x %x %x %x %x", &frame, &port, &connected,
+                            &buttons, &lx, &ly, &rx, &ry, &analog[0], &analog[1], &analog[2], &analog[3], &analog[4],
+                            &analog[5], &analog[6], &analog[7]);
+        if (n != 16) continue;
+        store(frame, port, connected, buttons, lx, ly, rx, ry, analog);
+    }
+    LOGR("det: replay %s, %zu frames", path, g_replay.size() / kPorts);
+}
+
+Sample ReplayAt(uint64_t frame, int port) {
+    LoadReplay();
+    if (g_replay.empty()) return {};
+    uint64_t last = g_replay.size() / kPorts - 1;
+    if (frame > last) {
+        if (!g_replay_held) {
+            g_replay_held = true;
+            LOGR("det: replay held at frame %llu (file ends at %llu)", (unsigned long long)last, (unsigned long long)last);
+        }
+        frame = last;
+    }
+    return g_replay[size_t(frame) * kPorts + port];
+}
+
+void WritePads(uint64_t frame) {
+    if (!C().record) return;
+    static FILE* f = nullptr;
+    static bool opened = false;
+    if (!opened) {
+        opened = true;
+        EnsureParentDir(C().record);
+        f = std::fopen(C().record, "w");
+        if (!f) {
+            LOGE("det: cannot write %s", C().record);
+            return;
+        }
+        std::fprintf(f, "# fuzion-input 2\n");
+        std::fprintf(f, "# BizHawk-style movie text. One line per frame. Four ports, pipe-separated.\n");
+        std::fprintf(f, "# LogKey:frame|P1 c,buttons,lx,ly,rx,ry,a,b,x,y,black,white,lt,rt|P2 ...|P3 ...|P4 ...\n");
+        std::fprintf(f, "# buttons and analog bytes are hex. sticks are signed. version 1 (one line per port) still loads.\n");
+        if (C().port2_mash)
+            std::fprintf(f, "# port 2 mash seed %u. 8-present holds. menu cadence for the first 4500 presents, then a mash.\n",
+                         C().port2_seed);
+    }
+    if (!f) return;
+    std::fprintf(f, "%llu", (unsigned long long)frame);
+    for (int p = 0; p < kPorts; p++) {
+        const Sample& s = g_latched[p];
+        std::fprintf(f, "|%u,%04x,%d,%d,%d,%d,%02x,%02x,%02x,%02x,%02x,%02x,%02x,%02x", s.connected ? 1u : 0u, s.buttons,
+                     int(s.lx), int(s.ly), int(s.rx), int(s.ry), s.analog[0], s.analog[1], s.analog[2], s.analog[3],
+                     s.analog[4], s.analog[5], s.analog[6], s.analog[7]);
+    }
+    std::fprintf(f, "\n");
+    std::fflush(f);
+}
+
+void LatchNext() {
+    for (int p = 0; p < kPorts; p++) g_latched[p] = g_pending[p];
+}
