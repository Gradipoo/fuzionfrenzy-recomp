+void StateHeader(const std::vector<Exc>& exc) {
+    if (!g_state || g_state_header) return;
+    g_state_header = true;
+    std::fprintf(g_state, "# det 1\n");
+    std::fprintf(g_state, "# fixed=%d seed=%s stall_ms=%u\n", C().fixed ? 1 : 0, C().have_seed ? "set" : "unset", C().stall_ms);
+    std::fprintf(g_state, "# clock qpc_per_frame=%llu interrupt_100ns_per_frame=%llu rdtsc_per_frame=%llu\n",
+                 (unsigned long long)kPerfPerFrame, (unsigned long long)kInterruptPerFrame,
+                 (unsigned long long)(kRdtscHz / 60ull));
+    std::fprintf(g_state, "# epoch_100ns=%llu rng_global=%08x\n", (unsigned long long)kEpoch100ns, g_rng_va);
+    std::fprintf(g_state, "# excluded from phys (zeroed in the hash):\n");
+    for (const Exc& e : exc)
+        std::fprintf(g_state, "# exclude %08x %08x %s\n", e.va, e.end - e.va, e.name ? e.name : "?");
+    std::fprintf(g_state, "# stacks at D0000000 are not hashed. system is committed pages at B0000000.\n");
+    std::fprintf(g_state, "# user slices are 4MB from 00000000 through 7FFE0000. index 0 starts at 00010000.\n");
+    std::fprintf(g_state, "# F frame total data phys system user seed qpc rdtsc delay\n");
+    std::fprintf(g_state, "# P frame 64 hashes of 1MB physical slices from 80000000\n");
+    std::fprintf(g_state, "# D frame section=hash. U frame index=hash for committed user slices.\n");
+    std::fprintf(g_state, "# NaN payloads are canonical quiet NaNs in the hash. Guest RAM is not rewritten.\n");
+}
+
+void DumpRegion(uint64_t frame, const char* name, uint32_t va, uint32_t size, const std::vector<Exc>& exc) {
+    const Cfg& c = C();
+    if (!c.dump_dir || c.dump_frame < 0 || uint64_t(c.dump_frame) != frame) return;
+    if (c.dump_region && c.dump_region[0] && std::strcmp(c.dump_region, name) != 0) return;
+    std::string path = std::string(c.dump_dir) + "/frame_" + std::to_string(frame) + "_" + name + ".bin";
+    FILE* f = std::fopen(path.c_str(), "wb");
+    if (!f) {
+        LOGE("det: cannot write %s", path.c_str());
+        return;
+    }
+    std::vector<uint8_t> buf(4096);
+    for (uint32_t at = va; at < va + size;) {
+        uint32_t n = std::min<uint32_t>(4096, va + size - at);
+        bool gap = false;
+        for (const Exc& e : exc)
+            if (Overlap(at, at + n, e)) gap = true;
+        if (gap || !mem::IsCommitted(at)) std::memset(buf.data(), 0, n);
+        else std::memcpy(buf.data(), kernel::HostPtr(at), n);
+        std::fwrite(buf.data(), 1, n, f);
+        at += n;
+    }
+    std::fclose(f);
+    LOGR("det: dumped %s", path.c_str());
+}
+
+struct ExpF {
+    bool ok = false;
+    bool have_slices = false;
+    uint64_t total = 0, data = 0, phys = 0, system = 0, user = 0;
+    uint64_t slices[64] = {};
+};
+
+std::vector<ExpF> g_exp;
+bool g_exp_loaded = false;
+
+void LoadExpect() {
+    if (g_exp_loaded) return;
+    g_exp_loaded = true;
+    if (!C().expect) return;
+    std::ifstream in(C().expect);
+    if (!in) {
+        LOGE("det: expect file missing: %s", C().expect);
+        kernel::Shutdown(1);
+    }
+    std::string line;
+    while (std::getline(in, line)) {
+        if (line.size() < 2 || line[0] == '#') continue;
+        if (line[0] == 'F') {
+            unsigned long long frame = 0, total = 0, data = 0, phys = 0, system = 0, user = 0;
+            unsigned long long seed = 0, qpc = 0, rdtsc = 0, delay = 0;
+            if (std::sscanf(line.c_str(),
+                            "F %llu total=%llx data=%llx phys=%llx system=%llx user=%llx seed=%llx qpc=%llu rdtsc=%llu "
+                            "delay=%llu",
+                            &frame, &total, &data, &phys, &system, &user, &seed, &qpc, &rdtsc, &delay) < 6)
+                continue;
+            if (g_exp.size() <= frame) g_exp.resize(size_t(frame) + 1);
+            ExpF& e = g_exp[size_t(frame)];
+            e.ok = true;
+            e.total = total;
+            e.data = data;
+            e.phys = phys;
+            e.system = system;
+            e.user = user;
+        } else if (line[0] == 'P') {
+            unsigned long long frame = 0;
+            if (std::sscanf(line.c_str(), "P %llu", &frame) != 1) continue;
+            if (g_exp.size() <= frame) g_exp.resize(size_t(frame) + 1);
+            ExpF& e = g_exp[size_t(frame)];
+            const char* p = std::strchr(line.c_str(), ' ');
+            if (p) p = std::strchr(p + 1, ' ');
+            int i = 0;
+            while (p && i < 64) {
+                unsigned long long slice = 0;
+                if (std::sscanf(p, " %llx", &slice) != 1) break;
+                e.slices[i++] = slice;
+                const char* next = std::strchr(p + 1, ' ');
+                if (!next) break;
+                p = next;
+            }
+            e.have_slices = i == 64;
+        }
+    }
+    LOGR("det: expect %s, %zu frames", C().expect, g_exp.size());
+}
+
+void DumpSpan(const char* dir, uint64_t frame, const char* name, uint32_t va, uint32_t size, const std::vector<Exc>& exc) {
+    std::string path = std::string(dir) + "/frame_" + std::to_string(frame) + "_" + name + ".bin";
+    FILE* f = std::fopen(path.c_str(), "wb");
+    if (!f) {
+        LOGE("det: cannot write %s", path.c_str());
+        return;
+    }
+    std::vector<uint8_t> buf(4096);
+    for (uint32_t at = va; at < va + size;) {
+        uint32_t n = std::min<uint32_t>(4096, va + size - at);
+        bool gap = false;
+        for (const Exc& e : exc)
+            if (Overlap(at, at + n, e)) gap = true;
+        if (gap || !mem::IsCommitted(at)) std::memset(buf.data(), 0, n);
+        else std::memcpy(buf.data(), kernel::HostPtr(at), n);
+        std::fwrite(buf.data(), 1, n, f);
+        at += n;
+    }
+    std::fclose(f);
+    LOGR("det: dumped %s", path.c_str());
+}
+
+void ReportDesync(uint64_t frame, const char* region, uint64_t got, uint64_t want, const std::vector<Exc>& exc) {
+    const char* dir = C().dump_dir && C().dump_dir[0] ? C().dump_dir : "det-desync";
+#if defined(_WIN32)
+    _mkdir(dir);
+#else
+    mkdir(dir, 0755);
+#endif
+    std::string path = std::string(dir) + "/desync_" + std::to_string(frame) + ".txt";
+    FILE* f = std::fopen(path.c_str(), "w");
+    if (!f) {
+        LOGE("det: cannot write %s", path.c_str());
+    } else {
+        std::fprintf(f, "desync frame %llu\n", (unsigned long long)frame);
+        std::fprintf(f, "region %s\n", region);
+        std::fprintf(f, "reference %016llx\n", (unsigned long long)want);
+        std::fprintf(f, "local %016llx\n", (unsigned long long)got);
+        std::fprintf(f, "snapshot %s/frame_%llu_%s.bin\n", dir, (unsigned long long)frame, region);
+        std::fprintf(f, "reference log %s\n", C().expect ? C().expect : "-");
+        std::fclose(f);
+        LOGR("det: wrote %s", path.c_str());
+    }
+    if (std::strncmp(region, "phys_", 5) == 0) {
+        int idx = std::atoi(region + 5);
+        if (idx >= 0 && idx < 64)
+            DumpSpan(dir, frame, region, 0x80000000u + uint32_t(idx) * 0x100000u, 0x100000u, exc);
+    } else if (std::strcmp(region, "system") == 0) {
+        DumpSpan(dir, frame, "system", mem::kSystemBase, mem::kSystemSize, {});
+    } else if (std::strncmp(region, "user_", 5) == 0) {
+        uint32_t index = uint32_t(std::strtoul(region + 5, nullptr, 10));
+        uint32_t base = index * 0x400000u;
+        uint32_t from = std::max(base, mem::kUserLow);
+        uint32_t to = std::min(base + 0x400000u, mem::kUserHigh);
+        DumpSpan(dir, frame, region, from, to - from, {});
+    } else if (std::strcmp(region, "user") != 0 && std::strcmp(region, "total") != 0 && kernel::g_image) {
+        for (const xbe::Section& s : kernel::g_image->sections) {
+            if (!(s.flags & xbe::kWritable) || !s.vsize) continue;
+            if (region[0] == '.' && s.name != region) continue;
+            DumpSpan(dir, frame, s.name.c_str(), s.va, s.vsize, exc);
+            if (region[0] == '.') break;
+        }
+    }
+    if (g_state) std::fflush(g_state);
+    LOGE("det: desync at frame %llu region %s", (unsigned long long)frame, region);
+    kernel::Shutdown(1);
+}
+
+void CheckExpect(uint64_t frame, uint64_t total, uint64_t data, uint64_t phys, uint64_t system, uint64_t user,
+                 const uint64_t slices[64], const std::vector<Exc>& exc) {
+    LoadExpect();
+    if (!C().expect) return;
+    if (frame >= g_exp.size() || !g_exp[size_t(frame)].ok) return;
+    const ExpF& e = g_exp[size_t(frame)];
+    if (e.total == total && e.data == data && e.phys == phys && e.system == system && e.user == user) return;
+    const char* region = "total";
+    uint64_t got = total, want = e.total;
+    if (e.data != data) {
+        region = "data";
+        got = data;
+        want = e.data;
+    } else if (e.phys != phys) {
+        region = "phys";
+        got = phys;
+        want = e.phys;
+        if (e.have_slices) {
+            for (int i = 0; i < 64; i++) {
+                if (e.slices[i] != slices[i]) {
+                    static char name[16];
+                    std::snprintf(name, sizeof name, "phys_%02d", i);
+                    region = name;
+                    got = slices[i];
+                    want = e.slices[i];
+                    break;
+                }
+            }
+        }
+    } else if (e.system != system) {
+        region = "system";
+        got = system;
+        want = e.system;
+    } else if (e.user != user) {
+        region = "user";
+        got = user;
+        want = e.user;
+    }
+    ReportDesync(frame, region, got, want, exc);
+}
+
+void WriteState(uint64_t frame) {
+    OpenState();
+    std::vector<Exc> exc;
+    d3d::VolatileSpans(AddExc, &exc);
+    std::sort(exc.begin(), exc.end(), [](const Exc& a, const Exc& b) { return a.va < b.va; });
+    StateHeader(exc);
+
+    uint64_t data_h = kHashBasis;
+    if (kernel::g_image) {
+        if (g_state) std::fprintf(g_state, "D %llu", (unsigned long long)frame);
+        for (const xbe::Section& s : kernel::g_image->sections) {
+            if (!(s.flags & xbe::kWritable) || !s.vsize) continue;
+            uint64_t h = HashVa(s.va, s.vsize, exc, kHashBasis);
+            data_h = Mix(data_h, h);
+            if (g_state) std::fprintf(g_state, " %s=%016llx", s.name.c_str(), (unsigned long long)h);
+            DumpRegion(frame, s.name.c_str(), s.va, s.vsize, exc);
+        }
+        if (g_state) std::fprintf(g_state, "\n");
+    }
+
+    uint64_t phys_h = kHashBasis;
+    uint64_t slices[64];
+    for (int i = 0; i < 64; i++) {
+        uint32_t va = 0x80000000u + uint32_t(i) * 0x100000u;
+        slices[i] = HashVa(va, 0x100000u, exc, kHashBasis);
+        phys_h = Mix(phys_h, slices[i]);
+        char name[16];
+        std::snprintf(name, sizeof name, "phys_%02d", i);
+        DumpRegion(frame, name, va, 0x100000u, exc);
+    }
+
+    uint64_t system_h = kHashBasis;
+    for (uint32_t va = mem::kSystemBase; va < mem::kSystemBase + mem::kSystemSize; va += mem::kPage) {
+        if (!mem::IsCommitted(va)) continue;
+        system_h = Mix(system_h, va);
+        system_h = HashBytes(static_cast<const uint8_t*>(kernel::HostPtr(va)), mem::kPage, system_h);
+    }
+    if (C().dump_region && std::strcmp(C().dump_region, "system") == 0)
+        DumpRegion(frame, "system", mem::kSystemBase, mem::kSystemSize, {});
+
+    // The whole user window, not only addresses above the image. Early heap sits just past .data.
+    uint64_t user_h = kHashBasis;
+    std::string user_line;
+    for (uint32_t base = 0; base < mem::kUserHigh; base += 0x400000u) {
+        uint32_t from = std::max(base, mem::kUserLow);
+        uint32_t to = std::min(base + 0x400000u, mem::kUserHigh);
+        bool any = false;
+        uint64_t h = kHashBasis;
+        for (uint32_t va = from; va < to; va += mem::kPage) {
+            if (!mem::IsCommitted(va)) continue;
+            any = true;
+            h = Mix(h, va);
+            h = HashBytes(static_cast<const uint8_t*>(kernel::HostPtr(va)), mem::kPage, h);
+        }
+        if (!any) continue;
+        user_h = Mix(user_h, h);
+        uint32_t index = base / 0x400000u;
+        char piece[64];
+        std::snprintf(piece, sizeof piece, " %u=%016llx", index, (unsigned long long)h);
+        user_line += piece;
+        char name[16];
+        std::snprintf(name, sizeof name, "user_%u", index);
+        if (C().dump_region && std::strcmp(C().dump_region, name) == 0) DumpRegion(frame, name, from, to - from, {});
+    }
+
+    uint64_t total = kHashBasis;
+    total = Mix(total, data_h);
+    total = Mix(total, phys_h);
+    total = Mix(total, system_h);
+    total = Mix(total, user_h);
+    uint32_t seed = RngNow();
+    if (g_state) {
+        std::fprintf(g_state, "P %llu", (unsigned long long)frame);
+        for (uint64_t s : slices) std::fprintf(g_state, " %016llx", (unsigned long long)s);
+        std::fprintf(g_state, "\n");
+        if (!user_line.empty()) std::fprintf(g_state, "U %llu%s\n", (unsigned long long)frame, user_line.c_str());
+        std::fprintf(g_state,
+                     "F %llu total=%016llx data=%016llx phys=%016llx system=%016llx user=%016llx seed=%08x qpc=%llu "
+                     "rdtsc=%llu delay=%llu\n",
+                     (unsigned long long)frame, (unsigned long long)total, (unsigned long long)data_h,
+                     (unsigned long long)phys_h, (unsigned long long)system_h, (unsigned long long)user_h, seed,
+                     (unsigned long long)g_qpc.load(), (unsigned long long)g_rdtsc.load(),
+                     (unsigned long long)g_delay.load());
+        std::fflush(g_state);
+    }
+    static uint32_t last_seed = 0;
+    static bool have_last = false;
+    if (!have_last || seed != last_seed) {
+        LOGR("det: rng seed at frame %llu is %08x", (unsigned long long)frame, seed);
+        last_seed = seed;
+        have_last = true;
+    }
+    if ((frame % 60ull) == 0)
+        LOGR("det: frame %llu total %016llx seed %08x", (unsigned long long)frame, (unsigned long long)total, seed);
+    CheckExpect(frame, total, data_h, phys_h, system_h, user_h, slices, exc);
+}
+
+void LogMode() {
+    if (g_logged_mode) return;
+    g_logged_mode = true;
+    const Cfg& c = C();
+    LOGR("det: fixed=%d record=%s replay=%s frames=%llu stall_ms=%u seed=%s state=%s", c.fixed ? 1 : 0,
+         c.record ? c.record : "-", c.replay ? c.replay : "-", (unsigned long long)c.frames, c.stall_ms,
+         c.have_seed ? "set" : "unset", c.state_log ? c.state_log : "-");
+    if (c.fixed) {
+        LOGR("det: clocks are frame-derived (qpc +%llu, interrupt +%llu 100ns, rdtsc +%llu, tick ms = frame*1000/60)",
+             (unsigned long long)kPerfPerFrame, (unsigned long long)kInterruptPerFrame,
+             (unsigned long long)(kRdtscHz / 60ull));
+        LOGR("det: presenter KeDelay yields the guest turn, vblank advances on present, mixer advances %u samples",
+             kAudioFrames);
+    }
+    if (c.port2_mash && c.port2_keys)
+        LOGR("det: port 2 mash seed %08x overrides FUZION_PORT2_KEYS", c.port2_seed);
+    else if (c.port2_mash)
+        LOGR("det: port 2 is a seeded mash, seed %08x, and a recording stores that sample", c.port2_seed);
+    else if (c.port2_keys)
+        LOGR("det: keyboard drives port 2; a recording stores that sample");
+}
