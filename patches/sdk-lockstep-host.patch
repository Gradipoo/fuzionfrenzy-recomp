+#pragma once
+// Lockstep determinism harness. Every entry is a no-op unless a flag or env var turns it on,
+// so a normal launch keeps the clocks, the pads, the mixer and the frame pacing it has now.
+#include <cstdint>
+
+struct X86Context;
+
+namespace input {
+struct Pad;
+}
+
+namespace det {
+
+void SetArgs(int argc, char** argv);
+
+bool FixedStep();   // --fixed-step / FUZION_FIXED_STEP
+bool Recording();   // --record-input / FUZION_RECORD_INPUT
+bool Replaying();   // --replay-input / FUZION_REPLAY_INPUT
+bool Minimized();   // --minimized / FUZION_MINIMIZED
+// Port scan and pad latch run from the frame edge instead of a wall-clock thread.
+bool FramePads();
+
+void FilterPad(int port, input::Pad& pad);
+void WatchRng(uint32_t guest_va);  // MSVC rand global, logged and optionally overwritten
+void OnImageLoaded();
+void OnPresented(X86Context& ctx);
+
+void NoteQpc();
+void NoteRdtsc();
+void NoteDelay();
+
+uint64_t PerfCounter();
+uint64_t InterruptTime100ns();
+uint64_t SystemTime100ns();
+uint64_t Rdtsc();
+uint32_t TickMs();
+
+// Guest queries. A read that would return the same value as the last read of that
+// clock advances one sim tick first. This title waits on KeQueryPerformanceCounter
+// until half a second of counts have elapsed (frequency/2) before it will present again.
+uint64_t ClockQpc();
+uint64_t ClockRdtsc();
+uint64_t ClockInterrupt();
+uint64_t ClockSystem();
+// Relative waits. hundred_ns is a guest duration. Whole ticks are consumed, the rest dropped.
+void Consume100ns(uint64_t hundred_ns);
+// The thread that presents owns sim time. Any other thread's KeDelay waits for that clock
+// instead of returning at once and spinning.
+void NotePacer();
+bool OnPacer();
+void WaitTicks(uint64_t ticks);
+// Call while this thread still holds the turn, before BlockGuest. Registers the
+// deadline and marks the thread in transit so a present yield cannot return
+// until the delay is waiting on a future tick or the thread has blocked again.
+void BeginDelay(uint64_t ticks);
+uint64_t WholeTicks(uint64_t hundred_ns);
+// Sim tick and object waits. A guest timeout becomes an absolute sim tick.
+// ArmWait while the turn is held, then BlockGuest, then Park. Park returns when
+// that tick arrives or a dispatcher signal kicks. UINT64_MAX waits only for a kick.
+uint64_t SimTick();
+uint64_t TimeoutTick(int64_t due_100ns);
+void ArmWait(uint64_t deadline_tick);
+void Park();
+void AdvanceToTick(uint64_t tick);
+void KickTimeWaiters();
+
+// One guest thread runs at a time while fixed-step is on. Enter/Leave wrap a guest call.
+// Block/Unblock drop the turn across a kernel wait. Yield runs every thread that is
+// already waiting until each of them is blocked again, so a Sleep(0) poll of the
+// background loader observes the same APC on every run.
+void EnterGuest();
+void LeaveGuest();
+void BlockGuest();
+void UnblockGuest();
+void YieldGuest();
+// Taken while the creator still holds the turn, then claimed on the new thread
+// before its first guest call. The new thread's place in line is fixed then.
+uint64_t ReserveTicket();
+void ClaimTicket(uint64_t ticket);
+// PsTerminateSystemThread ends in pthread_exit, which does not run the CallGuest
+// destructor. Drop the turn first. Leaving it set blocks every other thread in UnblockGuest.
+void AbandonGuest();
+// Alertable waits with a queued APC still have work. QueueApc / the wait flip this.
+void NoteDeliverable(int delta);
+// Presenter's KeDelay: consume whole ticks, then yield. A sub-frame delay that woke
+// nobody still advances one tick, so a timed poll cannot spin on the wall clock.
+void PacerDelay(uint64_t hundred_ns);
+
+}  // namespace det
