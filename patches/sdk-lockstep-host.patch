+void OnImageLoaded() {
+    if (!C().fixed && !C().have_seed && !C().record && !C().replay && !C().state_log) return;
+    LogMode();
+    if (!g_rng_va) return;
+    uint32_t cur = kernel::R32(g_rng_va);
+    LOGR("det: rng global %08x holds %08x at image load", g_rng_va, cur);
+    if (C().have_seed) {
+        kernel::W32(g_rng_va, C().seed);
+        LOGR("det: rng global %08x forced to %08x (a later srand can replace it; the frame log shows that)", g_rng_va,
+             C().seed);
+    }
+}
+
+// Port 2 (index 1), connected from the first sample. A pure function of the
+// frame and the mash seed: the same presents always produce the same report,
+// and the recording stores that report so a later replay does not roll again.
+// The first 4500 presents (75 s, the same window FUZION_AUTOSTART uses to get
+// through the intro and the menus) repeat a 600-present cycle: Start, D-pad
+// Up, A. After that, Start is rare and the rest is an 8-present mash.
+Sample MashPort2(uint64_t frame) {
+    constexpr uint64_t kCycle = 600;
+    constexpr uint64_t kMenuFrames = 4500;
+    Sample s;
+    s.connected = true;
+    const uint32_t slot = uint32_t(frame / 8);
+    uint32_t r = C().port2_seed + slot * 0x9E3779B9u;
+    r ^= r << 13;
+    r ^= r >> 17;
+    r ^= r << 5;
+    if (r == 0) r = 0xA5A5A5A5u;
+    auto cardinal = [&](unsigned dir) {
+        if (dir == 1) {
+            s.buttons = uint16_t(s.buttons | 0x0001);
+            s.ly = 32767;
+        } else if (dir == 2) {
+            s.buttons = uint16_t(s.buttons | 0x0002);
+            s.ly = -32767;
+        } else if (dir == 3) {
+            s.buttons = uint16_t(s.buttons | 0x0004);
+            s.lx = -32767;
+        } else if (dir == 4) {
+            s.buttons = uint16_t(s.buttons | 0x0008);
+            s.lx = 32767;
+        }
+    };
+    if (frame < kMenuFrames) {
+        const uint64_t phase = frame % kCycle;
+        if (phase < 30) s.buttons = uint16_t(s.buttons | 0x0010);
+        else if (phase >= 180 && phase < 210) cardinal(1);
+        else if (phase >= 300 && phase < 330) s.analog[0] = 0xFF;
+        if ((r % 5u) == 0) cardinal(1u + (r % 4u));
+        return s;
+    }
+    if ((r % 32u) == 0) s.buttons = uint16_t(s.buttons | 0x0010);
+    cardinal(r % 5u);
+    if ((r & 1u) == 0) s.analog[0] = 0xFF;
+    if ((r % 7u) == 0) s.analog[1] = 0xFF;
+    if ((r % 11u) == 0) s.analog[2] = 0xFF;
+    if ((r % 13u) == 0) s.analog[3] = 0xFF;
+    if (s.lx == 0 && s.ly == 0) {
+        switch ((r >> 8) & 3u) {
+            case 0: s.lx = 32767; break;
+            case 1: s.lx = -32767; break;
+            case 2: s.ly = 32767; break;
+            default: s.ly = -32767; break;
+        }
+    }
+    return s;
+}
+
+void FilterPad(int port, input::Pad& pad) {
+    if (port < 0 || port >= kPorts) return;
+    std::lock_guard<std::mutex> lock(g_pad_lock);
+    const bool mash = C().port2_mash && port == 1;
+    if (C().replay && !mash) {
+        pad = ReplayAt(g_frame.load(std::memory_order_relaxed), port).Pad();
+        // Mash plus record stores the replayed ports and the mash together.
+        // Replay alone still returns here, so an unset mash flag changes nothing.
+        if (!(C().port2_mash && C().record)) return;
+    }
+    if (mash) pad = MashPort2(g_frame.load(std::memory_order_relaxed)).Pad();
+    if (C().record || C().fixed) {
+        g_pending[port] = Sample(pad);
+        if (!g_seen[port]) {
+            g_latched[port] = g_pending[port];
+            g_seen[port] = true;
+        }
+        pad = g_latched[port].Pad();
+    }
+}
+
+void OnPresented(X86Context& ctx) {
+    const Cfg& c = C();
+    if (!c.fixed && !c.record && !c.replay && !c.state_log && !c.frames && !c.stall_ms && !c.expect) return;
+    if (g_in_present) return;
+    g_in_present = true;
+    NotePacer();
+    LogMode();
+    if (c.stall_ms) std::this_thread::sleep_for(std::chrono::milliseconds(c.stall_ms));
+    if (FramePads()) xapi::PollPortsOnce();
+    if (c.fixed) dsound::AdvanceFixed(ctx, kAudioFrames);
+    if (c.fixed) kernel::FireDueTimers(ctx);
+
+    uint64_t frame = g_frame.load(std::memory_order_relaxed);
+    if (c.state_log || c.dump_dir || c.expect) WriteState(frame);
+    {
+        std::lock_guard<std::mutex> lock(g_pad_lock);
+        if (c.record) WritePads(frame);
+        if (c.record || c.fixed) LatchNext();
+    }
+    uint64_t next = frame + 1;
+    g_frame.store(next, std::memory_order_relaxed);
+    if (c.fixed) {
+        std::lock_guard<std::mutex> lock(g_time_mu);
+        AdvanceTicksLocked(1);
+    }
+    // BumpVblank signals the vblank event. That kick takes g_time_mu, so it
+    // stays outside the lock above.
+    if (c.fixed && (next % 600ull) == 0)
+        LOGR("det: present %llu sim tick %llu", (unsigned long long)next,
+             (unsigned long long)g_time.load(std::memory_order_relaxed));
+    if (c.fixed) d3d::BumpVblank();
+    // XBE_LOAD_YIELD: the title thread holds the guest turn from boot. A frame
+    // that never calls KeDelay never lets the loader run, so the picture keeps
+    // presenting and the load never finishes. Yield after the clock steps.
+    // g_in_present stays set so a nested present does not step the clock again.
+    if (c.fixed) {
+        if (!g_logged_load_yield) {
+            g_logged_load_yield = true;
+            LOGR("det: each present yields the guest turn so a background load can run");
+        }
+        YieldGuest();
+    }
+    g_in_present = false;
+    if (c.frames && next >= c.frames) {
+        if (g_state) std::fflush(g_state);
+        LOGR("det: reached %llu frames, sim tick %llu, yield %.2f ms/present", (unsigned long long)c.frames,
+             (unsigned long long)g_time.load(std::memory_order_relaxed),
+             next ? double(g_yield_ns.load(std::memory_order_relaxed)) / double(next) / 1e6 : 0);
+        kernel::Shutdown(0);
+    }
+}
+
+}  // namespace det
