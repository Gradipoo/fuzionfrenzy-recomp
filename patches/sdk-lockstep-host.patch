+void EnsureParentDir(const char* path) {
+    if (!path || !path[0]) return;
+    std::error_code ec;
+    std::filesystem::path parent = std::filesystem::path(path).parent_path();
+    if (!parent.empty()) std::filesystem::create_directories(parent, ec);
+}
+
+uint64_t Mix(uint64_t h, uint64_t v) { return (h ^ v) * kHashPrime; }
+
+// ARM invalid-ops produce the default NaN. x86 keeps a payload. A quiet NaN is
+// hashed as the default quiet NaN (sign kept) so the two hosts match. Guest RAM
+// is not rewritten. An integer whose bits happen to be a NaN is hashed the same
+// way; pages are 4-byte aligned, and only complete 4- and 8-byte groups are looked at.
+uint32_t CanonF32(uint32_t v) {
+    if (((v >> 23) & 0xFFu) == 0xFFu && (v & 0x7FFFFFu) != 0) return (v & 0x80000000u) | 0x7FC00000u;
+    return v;
+}
+uint64_t CanonWord(uint64_t v) {
+    if (((v >> 52) & 0x7FFu) == 0x7FFu && (v & 0x000FFFFFFFFFFFFFull) != 0)
+        return (v & 0x8000000000000000ull) | 0x7FF8000000000000ull;
+    uint32_t lo = CanonF32(uint32_t(v));
+    uint32_t hi = CanonF32(uint32_t(v >> 32));
+    return uint64_t(lo) | (uint64_t(hi) << 32);
+}
+
+uint64_t HashBytes(const uint8_t* p, size_t n, uint64_t h) {
+    size_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        uint64_t v;
+        std::memcpy(&v, p + i, 8);
+        h = Mix(h, CanonWord(v));
+    }
+    uint64_t tail = 0;
+    if (i < n) std::memcpy(&tail, p + i, n - i);
+    if (i + 4 <= n) {
+        uint32_t lo = CanonF32(uint32_t(tail));
+        tail = (tail & ~0xFFFFFFFFull) | lo;
+    }
+    if (i < n) h = Mix(h, tail);
+    return h;
+}
+
+uint64_t HashZeros(size_t n, uint64_t h) {
+    uint64_t z = 0;
+    while (n >= 8) {
+        h = Mix(h, z);
+        n -= 8;
+    }
+    if (n) h = Mix(h, z);
+    return h;
+}
+
+struct Exc {
+    uint32_t va, end;
+    const char* name;
+};
+
+void AddExc(uint32_t va, uint32_t size, const char* name, void* user) {
+    if (!va || !size) return;
+    static_cast<std::vector<Exc>*>(user)->push_back({va, va + size, name});
+}
+
+bool Overlap(uint32_t a, uint32_t b, const Exc& e) { return a < e.end && e.va < b; }
+
+uint64_t HashVa(uint32_t va, uint32_t size, const std::vector<Exc>& exc, uint64_t h) {
+    uint32_t at = va;
+    const uint32_t end = va + size;
+    while (at < end) {
+        uint32_t run = end;
+        const Exc* hit = nullptr;
+        for (const Exc& e : exc) {
+            if (e.end <= at || e.va >= end) continue;
+            if (e.va <= at) {
+                hit = &e;
+                break;
+            }
+            if (e.va < run) run = e.va;
+        }
+        if (!hit) {
+            h = HashBytes(static_cast<const uint8_t*>(kernel::HostPtr(at)), run - at, h);
+            at = run;
+        } else {
+            uint32_t stop = std::min(hit->end, end);
+            h = HashZeros(stop - at, h);
+            at = stop;
+        }
+    }
+    return h;
+}
