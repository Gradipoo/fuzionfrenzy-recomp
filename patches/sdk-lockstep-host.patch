+bool FramePads() { return C().fixed || C().record || C().replay; }
+
+void NoteQpc() { g_qpc.fetch_add(1, std::memory_order_relaxed); }
+void NoteRdtsc() { g_rdtsc.fetch_add(1, std::memory_order_relaxed); }
+void NoteDelay() { g_delay.fetch_add(1, std::memory_order_relaxed); }
+
+uint64_t PerfCounter() { return g_time.load(std::memory_order_relaxed) * kPerfPerFrame; }
+uint64_t InterruptTime100ns() { return g_time.load(std::memory_order_relaxed) * kInterruptPerFrame; }
+uint64_t SystemTime100ns() { return kEpoch100ns + InterruptTime100ns(); }
+uint64_t Rdtsc() { return g_time.load(std::memory_order_relaxed) * (kRdtscHz / 60ull); }
+uint32_t TickMs() { return uint32_t((g_time.load(std::memory_order_relaxed) * 1000ull) / 60ull); }
+
+void PublishTime() {
+    uint64_t t = g_time.load(std::memory_order_relaxed);
+    kernel::SetDeterministicClocks(t * kInterruptPerFrame, kEpoch100ns + t * kInterruptPerFrame,
+                                   uint32_t((t * 1000ull) / 60ull));
+}
+
+void AdvanceTicksLocked(uint64_t ticks) {
+    if (!ticks) return;
+    g_time.fetch_add(ticks, std::memory_order_relaxed);
+    PublishTime();
+    g_time_cv.notify_all();
+}
+
+uint64_t Hold(uint64_t& last, bool& have, uint64_t now) {
+    if (have && now == last) {
+        if (!g_logged_spin) {
+            g_logged_spin = true;
+            LOGR("det: a clock read repeated, so the sim tick advanced. The title waits on QPC for frequency/2.");
+        }
+        AdvanceTicksLocked(1);
+        now = g_time.load(std::memory_order_relaxed);
+    }
+    have = true;
+    return now;
+}
+
+// RDTSC and interrupt time stay on the present's tick. A frame samples them
+// a handful of times; advancing on each repeat made the in-game timer run
+// several steps per present while the picture was still one frame. A tight
+// spin (many reads, no present) still advances, or a load that waits on the
+// counter would not finish. QPC is unchanged: the boot wait is thirty reads.
+constexpr int kSpinReads = 40;
+bool g_logged_spin_burst = false;
+thread_local int t_rdtsc_burst = 0;
+thread_local int t_interrupt_burst = 0;
+
+uint64_t PresentTick(uint64_t& last, bool& have, int& burst) {
+    uint64_t now = g_time.load(std::memory_order_relaxed);
+    if (!have || now != last) {
+        have = true;
+        last = now;
+        burst = 0;
+        return now;
+    }
+    if (++burst < kSpinReads) return now;
+    if (!g_logged_spin_burst) {
+        g_logged_spin_burst = true;
+        LOGR("det: a clock spin advanced the sim tick; ordinary repeats stay on the present");
+    }
+    AdvanceTicksLocked(1);
+    now = g_time.load(std::memory_order_relaxed);
+    last = now;
+    burst = 0;
+    return now;
+}
+
+uint64_t ClockQpc() {
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    uint64_t ticks = Hold(g_last_qpc, g_have_qpc, g_time.load(std::memory_order_relaxed));
+    g_last_qpc = ticks;
+    return ticks * kPerfPerFrame;
+}
+
+uint64_t ClockRdtsc() {
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    uint64_t ticks = PresentTick(g_last_rdtsc, g_have_rdtsc, t_rdtsc_burst);
+    return ticks * (kRdtscHz / 60ull);
+}
+
+uint64_t ClockInterrupt() {
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    uint64_t ticks = PresentTick(g_last_interrupt, g_have_interrupt, t_interrupt_burst);
+    return ticks * kInterruptPerFrame;
+}
+
+uint64_t ClockSystem() { return kEpoch100ns + ClockInterrupt(); }
+
+void Consume100ns(uint64_t hundred_ns) {
+    if (!hundred_ns) return;
+    uint64_t ticks = hundred_ns / kInterruptPerFrame;
+    if (!ticks) return;
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    AdvanceTicksLocked(ticks);
+}
+
+void NotePacer() { t_pacer = true; }
+bool OnPacer() { return t_pacer; }
+
+bool g_logged_grant = false;
+bool g_logged_due = false;
+int g_pacer_waiting = 0;  // under g_time_mu. Presenter is inside a kernel wait.
+
+// A non-presenter delay registers its deadline before it drops the turn.
+// g_waking counts threads that have left that wait (or not entered it yet) and
+// have not taken the turn again. Both sit under g_time_mu. The present yield
+// will not resume the title while a registered deadline is already due or
+// g_waking is non-zero. XBE_LOAD_YIELD.
+struct DeadlineEnt {
+    uint64_t token;
+    uint64_t deadline;
+};
+std::vector<DeadlineEnt> g_deadlines;
+uint64_t g_deadline_seq = 1;
+int g_waking = 0;
+thread_local uint64_t t_deadline_token = 0;
+thread_local uint64_t t_deadline_ticks = 0;
+thread_local bool t_waking = false;
+
+void PublishSched();
+extern thread_local bool t_guest_hold;
+
+void RegisterDeadlineLocked(uint64_t ticks) {
+    t_deadline_ticks = g_time.load(std::memory_order_relaxed) + ticks;
+    t_deadline_token = g_deadline_seq++;
+    if (!t_deadline_token) t_deadline_token = g_deadline_seq++;
+    g_deadlines.push_back({t_deadline_token, t_deadline_ticks});
+}
+
+void EraseDeadlineLocked() {
+    if (!t_deadline_token) return;
+    for (auto it = g_deadlines.begin(); it != g_deadlines.end(); ++it) {
+        if (it->token == t_deadline_token) {
+            g_deadlines.erase(it);
+            break;
+        }
+    }
+    t_deadline_token = 0;
+    t_deadline_ticks = 0;
+}
+
+bool AnyDueLocked() {
+    uint64_t now = g_time.load(std::memory_order_relaxed);
+    for (const DeadlineEnt& ent : g_deadlines)
+        if (ent.deadline <= now) return true;
+    return false;
+}
+
+void BeginDelay(uint64_t ticks) {
+    if (!FixedStep() || !t_guest_hold) return;
+    if (!ticks) ticks = 1;
+    if (t_waking || t_deadline_token) return;
+    {
+        std::lock_guard<std::mutex> lock(g_time_mu);
+        RegisterDeadlineLocked(ticks);
+        t_waking = true;
+        g_waking++;
+    }
+    PublishSched();
+}
+
+std::atomic<uint64_t> g_kick{0};
+bool g_logged_park = false;
+
+// A thread asleep on the sim clock. seen is the kick value it has acknowledged.
+// The present yield does not resume the title while a sleeper's seen is behind
+// g_kick: that thread was notified and has not gone back to sleep or run yet.
+struct TimeSleeper {
+    uint64_t seen = 0;
+    bool asleep = false;
+    bool registered = false;
+    ~TimeSleeper();
+};
+thread_local TimeSleeper t_sl;
+std::vector<TimeSleeper*> g_sleepers;
+
+TimeSleeper::~TimeSleeper() {
+    if (!registered) return;
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    g_sleepers.erase(std::remove(g_sleepers.begin(), g_sleepers.end(), this), g_sleepers.end());
+    registered = false;
+    asleep = false;
+}
+
+void EnsureSleeperLocked() {
+    if (t_sl.registered) return;
+    g_sleepers.push_back(&t_sl);
+    t_sl.registered = true;
+}
+
+int UnackedKicksLocked() {
+    uint64_t kick = g_kick.load(std::memory_order_relaxed);
+    int n = 0;
+    for (TimeSleeper* s : g_sleepers)
+        if (s->asleep && s->seen != kick) n++;
+    return n;
+}
+
+uint64_t SimTick() { return g_time.load(std::memory_order_relaxed); }
+
+uint64_t TimeoutTick(int64_t due) {
+    uint64_t now_tick = g_time.load(std::memory_order_relaxed);
+    uint64_t span = 0;
+    if (due < 0) {
+        span = due == INT64_MIN ? ~0ull : uint64_t(-due);
+    } else {
+        uint64_t now_sys = kEpoch100ns + now_tick * kInterruptPerFrame;
+        if (uint64_t(due) <= now_sys) return now_tick;
+        span = uint64_t(due) - now_sys;
+    }
+    if (!span) return now_tick;
+    uint64_t ticks = span / kInterruptPerFrame;
+    if (!ticks) ticks = 1;
+    if (ticks > ~1ull - now_tick) return ~1ull;
+    return now_tick + ticks;
+}
+
+void KickTimeWaiters() {
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    g_kick.fetch_add(1, std::memory_order_relaxed);
+    g_time_cv.notify_all();
+}
+
+void ArmWait(uint64_t deadline_tick) {
+    if (!FixedStep() || !t_guest_hold) return;
+    if (t_waking || t_deadline_token) return;
+    {
+        std::lock_guard<std::mutex> lock(g_time_mu);
+        if (deadline_tick != ~0ull) {
+            t_deadline_ticks = deadline_tick;
+            t_deadline_token = g_deadline_seq++;
+            if (!t_deadline_token) t_deadline_token = g_deadline_seq++;
+            g_deadlines.push_back({t_deadline_token, t_deadline_ticks});
+        }
+        t_waking = true;
+        g_waking++;
+    }
+    if (!g_logged_park) {
+        g_logged_park = true;
+        LOGR("det: an object wait follows sim ticks instead of the wall clock");
+    }
+    PublishSched();
+}
+
+void Park() {
+    std::unique_lock<std::mutex> lock(g_time_mu);
+    EnsureSleeperLocked();
+    bool finite = t_deadline_token != 0;
+    uint64_t deadline = t_deadline_ticks;
+    for (;;) {
+        uint64_t now = g_time.load(std::memory_order_relaxed);
+        if (finite && now >= deadline) break;
+        // The presenter is blocked in its own kernel wait, so presents are not
+        // stepping the clock. Grant this deadline. The presenter's own wait does
+        // not come through here with a deadline, or it would grant itself.
+        if (finite && g_pacer_waiting) {
+            if (now < deadline) AdvanceTicksLocked(deadline - now);
+            break;
+        }
+        uint64_t kick = g_kick.load(std::memory_order_relaxed);
+        // Asleep before g_waking drops, so a yield cannot observe neither.
+        t_sl.seen = kick;
+        t_sl.asleep = true;
+        if (t_waking) {
+            t_waking = false;
+            if (g_waking > 0) g_waking--;
+            lock.unlock();
+            PublishSched();
+            lock.lock();
+            now = g_time.load(std::memory_order_relaxed);
+            if (finite && now >= deadline) break;
+            if (g_kick.load(std::memory_order_relaxed) != kick) break;
+        }
+        g_time_cv.wait(lock, [&] {
+            uint64_t t = g_time.load(std::memory_order_relaxed);
+            return g_kick.load(std::memory_order_relaxed) != kick || (finite && (t >= deadline || g_pacer_waiting != 0));
+        });
+        if (g_kick.load(std::memory_order_relaxed) != kick) break;
+    }
+    t_sl.asleep = false;
+    t_sl.seen = g_kick.load(std::memory_order_relaxed);
+    EraseDeadlineLocked();
+    if (!t_waking) {
+        t_waking = true;
+        g_waking++;
+    }
+    lock.unlock();
+    PublishSched();
+}
+
+void AdvanceToTick(uint64_t tick) {
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    uint64_t now = g_time.load(std::memory_order_relaxed);
+    if (tick > now) AdvanceTicksLocked(tick - now);
+}
+
+void WaitTicks(uint64_t ticks) {
+    if (!ticks) ticks = 1;
+    std::unique_lock<std::mutex> lock(g_time_mu);
+    EnsureSleeperLocked();
+    if (!t_deadline_token) RegisterDeadlineLocked(ticks);
+    bool granted = false;
+    while (g_time.load(std::memory_order_relaxed) < t_deadline_ticks) {
+        // The presenter is blocked in a kernel wait, so presents are not
+        // stepping the clock. Grant the rest of this delay. A Sleep on the
+        // loader then returns and can signal the presenter. A present yield
+        // does not set this flag: granting there would let a poll never block.
+        if (g_pacer_waiting) {
+            AdvanceTicksLocked(t_deadline_ticks - g_time.load(std::memory_order_relaxed));
+            granted = true;
+            break;
+        }
+        uint64_t kick = g_kick.load(std::memory_order_relaxed);
+        t_sl.seen = kick;
+        t_sl.asleep = true;
+        if (t_waking) {
+            // The deadline is still ahead. Leave the in-transit count so the
+            // yield can resume the title, then recheck before sleeping.
+            t_waking = false;
+            if (g_waking > 0) g_waking--;
+            lock.unlock();
+            PublishSched();
+            lock.lock();
+            if (g_time.load(std::memory_order_relaxed) >= t_deadline_ticks || g_pacer_waiting) continue;
+            if (g_kick.load(std::memory_order_relaxed) != kick) {
+                t_sl.asleep = false;
+                t_sl.seen = g_kick.load(std::memory_order_relaxed);
+                continue;
+            }
+        }
+        g_time_cv.wait(lock, [&] {
+            return g_time.load(std::memory_order_relaxed) >= t_deadline_ticks || g_pacer_waiting != 0 ||
+                   g_kick.load(std::memory_order_relaxed) != kick;
+        });
+        // A kick is not this delay ending. Acknowledge it and keep waiting,
+        // or the present yield stays in the kick forever.
+        if (g_kick.load(std::memory_order_relaxed) != kick && g_time.load(std::memory_order_relaxed) < t_deadline_ticks &&
+            !g_pacer_waiting) {
+            t_sl.asleep = false;
+            t_sl.seen = g_kick.load(std::memory_order_relaxed);
+            lock.unlock();
+            PublishSched();
+            lock.lock();
+        }
+    }
+    t_sl.asleep = false;
+    t_sl.seen = g_kick.load(std::memory_order_relaxed);
+    EraseDeadlineLocked();
+    if (!t_waking) {
+        t_waking = true;
+        g_waking++;
+    }
+    bool tell = false;
+    if (granted && !g_logged_grant) {
+        g_logged_grant = true;
+        tell = true;
+    }
+    lock.unlock();
+    PublishSched();
+    if (tell) LOGR("det: presenter is inside a wait, so a guest delay advances virtual time");
+}
+
+void SetPacerWaiting(bool waiting) {
+    if (!t_pacer) return;
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    g_pacer_waiting = waiting ? 1 : 0;
+    if (waiting) g_time_cv.notify_all();
+}
+
+uint64_t WholeTicks(uint64_t hundred_ns) { return hundred_ns / kInterruptPerFrame; }
+
+// One thread holds the turn (g_busy). Waiters are served in the order they blocked.
+// The ticket is taken while the thread still holds the turn, so a later wake-up
+// cannot reorder them. A thread that is parked is not waiting, and its ticket
+// does not block anyone else. A single "now serving" counter is not used: a
+// ticket whose thread stays parked would leave every later thread stuck.
+struct SchedWait {
+    uint64_t ticket = 0;
+    bool waiting = false;
+    bool has_ticket = false;
+    bool registered = false;
+    ~SchedWait();
+};
+thread_local SchedWait t_sw;
+std::vector<SchedWait*> g_sw;
+uint64_t g_next_ticket = 1;
+
+void EnsureSchedLocked() {
+    if (t_sw.registered) return;
+    g_sw.push_back(&t_sw);
+    t_sw.registered = true;
+}
+
+bool LowestTicketLocked() {
+    for (SchedWait* other : g_sw) {
+        if (other == &t_sw || !other->waiting || !other->has_ticket) continue;
+        if (other->ticket < t_sw.ticket) return false;
+        if (other->ticket == t_sw.ticket && other < &t_sw) return false;
+    }
+    return true;
+}
+
+std::mutex g_sched_mu;
+std::condition_variable g_sched_cv;
+int g_busy = 0;
+int g_waiting = 0;
+uint64_t g_sched_epoch = 0;  // under g_sched_mu. Bumped when g_waking changes.
+std::atomic<int> g_deliverable{0};
+std::atomic<uint64_t> g_handoffs{0};
+
+SchedWait::~SchedWait() {
+    if (!registered) return;
+    std::lock_guard<std::mutex> lock(g_sched_mu);
+    g_sw.erase(std::remove(g_sw.begin(), g_sw.end(), this), g_sw.end());
+    registered = false;
+}
+
+void PublishSched() {
+    std::lock_guard<std::mutex> lock(g_sched_mu);
+    g_sched_epoch++;
+    g_sched_cv.notify_all();
+}
+thread_local int t_guest_depth = 0;
+thread_local bool t_guest_hold = false;
+bool g_logged_yield = false;
+bool g_logged_load_yield = false;
+
+void NoteDeliverable(int delta) {
+    if (!delta || !FixedStep()) return;
+    g_deliverable.fetch_add(delta, std::memory_order_acq_rel);
+    g_sched_cv.notify_all();
+}
+
+void AcquireTurn() {
+    std::unique_lock<std::mutex> lock(g_sched_mu);
+    EnsureSchedLocked();
+    if (!t_sw.has_ticket) {
+        t_sw.ticket = g_next_ticket++;
+        t_sw.has_ticket = true;
+    }
+    if (g_busy || !LowestTicketLocked()) {
+        t_sw.waiting = true;
+        g_waiting++;
+        g_sched_cv.wait(lock, [] { return g_busy == 0 && LowestTicketLocked(); });
+        g_waiting--;
+        t_sw.waiting = false;
+    }
+    g_busy = 1;
+    t_guest_hold = true;
+    t_sw.has_ticket = false;
+}
+
+void ReleaseTurn() {
+    std::lock_guard<std::mutex> lock(g_sched_mu);
+    if (!t_guest_hold) return;
+    t_guest_hold = false;
+    g_busy = 0;
+    g_handoffs.fetch_add(1, std::memory_order_relaxed);
+    g_sched_cv.notify_all();
+}
+
+uint64_t ReserveTicket() {
+    if (!FixedStep()) return 0;
+    std::lock_guard<std::mutex> lock(g_sched_mu);
+    return g_next_ticket++;
+}
+
+void ClaimTicket(uint64_t ticket) {
+    if (!FixedStep() || !ticket) return;
+    std::lock_guard<std::mutex> lock(g_sched_mu);
+    EnsureSchedLocked();
+    t_sw.ticket = ticket;
+    t_sw.has_ticket = true;
+}
+
+void EnterGuest() {
+    if (!FixedStep()) return;
+    if (t_guest_depth++ > 0) return;
+    AcquireTurn();
+}
+
+void LeaveGuest() {
+    if (!FixedStep()) return;
+    if (t_guest_depth == 0) return;
+    if (--t_guest_depth > 0) return;
+    ReleaseTurn();
+}
+
+void BlockGuest() {
+    if (!FixedStep() || !t_guest_hold) return;
+    SetPacerWaiting(true);
+    {
+        std::lock_guard<std::mutex> lock(g_sched_mu);
+        EnsureSchedLocked();
+        t_sw.ticket = g_next_ticket++;
+        t_sw.has_ticket = true;
+    }
+    ReleaseTurn();
+}
+
+void UnblockGuest() {
+    if (!FixedStep() || t_guest_depth == 0 || t_guest_hold) return;
+    AcquireTurn();
+    if (t_waking) {
+        {
+            std::lock_guard<std::mutex> lock(g_time_mu);
+            t_waking = false;
+            if (g_waking > 0) g_waking--;
+        }
+        PublishSched();
+    }
+    SetPacerWaiting(false);
+}
+
+void AbandonGuest() {
+    if (!FixedStep() || t_guest_depth == 0) return;
+    t_guest_depth = 0;
+    bool wake = false;
+    {
+        std::lock_guard<std::mutex> lock(g_time_mu);
+        if (t_deadline_token) EraseDeadlineLocked();
+        if (t_waking) {
+            t_waking = false;
+            if (g_waking > 0) g_waking--;
+            wake = true;
+        }
+        if (t_sl.asleep || t_sl.registered) {
+            t_sl.asleep = false;
+            t_sl.seen = g_kick.load(std::memory_order_relaxed);
+            if (t_sl.registered) {
+                g_sleepers.erase(std::remove(g_sleepers.begin(), g_sleepers.end(), &t_sl), g_sleepers.end());
+                t_sl.registered = false;
+            }
+            wake = true;
+        }
+    }
+    if (wake) PublishSched();
+    {
+        std::lock_guard<std::mutex> lock(g_sched_mu);
+        t_sw.waiting = false;
+        t_sw.has_ticket = false;
+        if (t_sw.registered) {
+            g_sw.erase(std::remove(g_sw.begin(), g_sw.end(), &t_sw), g_sw.end());
+            t_sw.registered = false;
+        }
+    }
+    if (!t_guest_hold) return;
+    LOGR("det: a guest thread exited while it held the turn; the turn is released");
+    ReleaseTurn();
+}
+
+std::atomic<uint64_t> g_yield_ns{0};
+
+void YieldGuest() {
+    if (!FixedStep() || !t_guest_hold) return;
+    if (!g_logged_yield) {
+        g_logged_yield = true;
+        LOGR("det: presenter yield runs other guest threads until they block");
+    }
+    const auto yield_t0 = std::chrono::steady_clock::now();
+    std::unique_lock<std::mutex> lock(g_sched_mu);
+    t_guest_hold = false;
+    g_busy = 0;
+    g_sched_cv.notify_all();
+    // SignalChanged kicks object waits, and that kick takes the time lock.
+    // Drop the scheduler lock first. WaitTicks holds the time lock and then
+    // this one.
+    lock.unlock();
+    kernel::SignalChanged();
+    lock.lock();
+    // While an alertable APC is still queued, g_deliverable stays above zero, so the
+    // loader claims g_busy and pops it before this wait can return. A delay whose
+    // deadline is already due, or a thread between that delay and AcquireTurn, is
+    // also still work: g_waking and the deadline list live under g_time_mu, and
+    // this loop does not hold g_sched_mu across that lock.
+    while (true) {
+        g_sched_cv.wait(lock, [] {
+            return g_busy == 0 && g_waiting == 0 && g_deliverable.load(std::memory_order_acquire) == 0;
+        });
+        uint64_t epoch = g_sched_epoch;
+        lock.unlock();
+        bool due = false;
+        int waking = 0;
+        int unacked = 0;
+        {
+            std::lock_guard<std::mutex> tlock(g_time_mu);
+            due = AnyDueLocked();
+            waking = g_waking;
+            unacked = UnackedKicksLocked();
+            if (due || unacked) g_time_cv.notify_all();
+        }
+        if (due && !g_logged_due) {
+            g_logged_due = true;
+            LOGR("det: a guest delay that is already due runs before the present continues");
+        }
+        lock.lock();
+        bool idle = g_busy == 0 && g_waiting == 0 && g_deliverable.load(std::memory_order_acquire) == 0;
+        if (!due && waking == 0 && unacked == 0 && idle && g_sched_epoch == epoch) break;
+        // The sample said a due delay was still outstanding, or a kicked waiter
+        // has not acknowledged yet. Sleep until that thread publishes, instead
+        // of spinning. A publish bumps the epoch under this mutex, so a change
+        // that landed before the wait is visible and this does not sleep through it.
+        if ((due || waking != 0 || unacked != 0) && idle && g_sched_epoch == epoch) g_sched_cv.wait(lock);
+    }
+    g_busy = 1;
+    t_guest_hold = true;
+    g_yield_ns.fetch_add(uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                      std::chrono::steady_clock::now() - yield_t0)
+                                      .count()),
+                         std::memory_order_relaxed);
+}
+
+void PacerDelay(uint64_t hundred_ns) {
+    if (hundred_ns) Consume100ns(hundred_ns);
+    uint64_t before = g_handoffs.load(std::memory_order_relaxed);
+    YieldGuest();
+    if (!hundred_ns || hundred_ns >= kInterruptPerFrame) return;
+    if (g_handoffs.load(std::memory_order_relaxed) != before) return;
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    AdvanceTicksLocked(1);
+}
+
+void WatchRng(uint32_t guest_va) { g_rng_va = guest_va; }
