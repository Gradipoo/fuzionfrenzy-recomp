+bool RelayMatch() {
+    return C().lockstep && !(C().lock_peer && C().lock_peer[0]);
+}
+
+// The game has already been presenting. The match's frame 0 is the present
+// where the host's start notice is first seen, so we do not wait for inputs
+// from before that.
+uint64_t SessionFrame(uint64_t frame) {
+    if (!RelayMatch()) return frame;
+    static uint64_t origin = ~uint64_t{0};
+    if (origin == ~uint64_t{0}) origin = frame;
+    return frame >= origin ? frame - origin : 0;
+}
+
 void LockstepStop(const net::Result& r, uint64_t frame) {
     if (r.fail == net::Fail::None) return;
+    if (r.fail == net::Fail::Desync && RelayMatch()) {
+        static bool logged = false;
+        if (!logged) {
+            logged = true;
+            LOGE("det: lockstep hash mismatch at frame %llu", (unsigned long long)r.frame);
+        }
+        return;
+    }
     if (r.fail == net::Fail::Desync) {
