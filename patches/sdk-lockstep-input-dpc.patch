+// Set while DrainFixedDpcs is running a DPC on this thread. A DPC that queues
+// another one only appends; the outer drain runs it before returning.
+// g_fixed_dpc_mu keeps a second guest thread from running a DPC at the same
+// time. The nested call returns before taking the mutex.
+static std::mutex g_fixed_dpc_mu;
+static thread_local int t_dpc_drain = 0;
+
 void QueueDpc(uint32_t dpc, uint32_t arg1, uint32_t arg2) {
     std::lock_guard<std::mutex> lock(g_dpc_lock);
     W32(dpc + 0x14, arg1);  // KDPC.SystemArgument1 and 2
     W32(dpc + 0x18, arg2);
     g_dpcs.push_back({dpc, arg1, arg2});
+    // XBE_INPUT_DPC: the host DPC thread races the title's input poll. Fixed
+    // step leaves the DPC queued. FireDueTimers drains it on the next present,
+    // after that frame's poll and before the state hash. A wait drains first
+    // so the open path can be signalled. Normal play keeps the host thread.
+    if (det::FixedStep()) return;
     g_dpc_cv.notify_one();
     if (!g_dpc_thread) {
