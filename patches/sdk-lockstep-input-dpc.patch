+bool DrainFixedDpcs(X86Context& ctx) {
+    if (!det::FixedStep() || t_dpc_drain) return false;
+    std::lock_guard<std::mutex> gate(g_fixed_dpc_mu);
+    t_dpc_drain++;
+    bool ran = false;
+    for (;;) {
+        std::array<uint32_t, 3> d;
+        {
+            std::lock_guard<std::mutex> lock(g_dpc_lock);
+            if (g_dpcs.empty()) break;
+            d = g_dpcs.front();
+            g_dpcs.pop_front();
+        }
+        ran = true;
