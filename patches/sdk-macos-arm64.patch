+#include <cstring>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace kernel {
+extern const xbe::Image* g_image;
+void SetDeterministicClocks(uint64_t interrupt_100ns, uint64_t system_100ns, uint32_t tick_ms);
+void FireDueTimers(X86Context& ctx);
+}  // namespace kernel
+
+namespace d3d {
+void VolatileSpans(void (*fn)(uint32_t va, uint32_t size, const char* name, void* user), void* user);
+void BumpVblank();
+}  // namespace d3d
+
+namespace xapi {
+void PollPortsOnce();
+}  // namespace xapi
+
+namespace dsound {
+void AdvanceFixed(X86Context& ctx, uint32_t frames);
+}  // namespace dsound
+
+namespace det {
+namespace {
+
+int g_argc = 0;
+char** g_argv = nullptr;
+
+const char* Option(const char* name) {
+    std::string flag = std::string("--") + name;
+    std::string pref = flag + "=";
+    for (int i = 1; i < g_argc; i++) {
+        const char* a = g_argv[i];
+        if (!a) continue;
+        if (std::strncmp(a, pref.c_str(), pref.size()) == 0) return a + pref.size();
+        if (flag == a && i + 1 < g_argc && g_argv[i + 1] && std::strncmp(g_argv[i + 1], "--", 2) != 0) return g_argv[i + 1];
+    }
+    return nullptr;
+}
+
+bool Switch(const char* name) {
+    std::string flag = std::string("--") + name;
+    for (int i = 1; i < g_argc; i++)
+        if (g_argv[i] && flag == g_argv[i]) return true;
+    return false;
+}
+
+const char* EnvOrOpt(const char* env, const char* opt) {
+    if (const char* v = Option(opt)) return v;
+    if (const char* v = std::getenv(env)) return v[0] ? v : nullptr;
+    return nullptr;
+}
+
+bool EnvOrSwitch(const char* env, const char* opt) {
+    if (Switch(opt)) return true;
+    const char* v = std::getenv(env);
+    return v && v[0] && std::strcmp(v, "0") != 0;
+}
+
+struct Cfg {
+    bool fixed = false;
+    bool minimized = false;
+    const char* record = nullptr;
+    const char* replay = nullptr;
+    const char* state_log = nullptr;
+    const char* dump_dir = nullptr;
+    const char* dump_region = nullptr;
+    int64_t dump_frame = -1;
+    uint64_t frames = 0;
+    uint32_t stall_ms = 0;
+    bool have_seed = false;
+    uint32_t seed = 1;
+};
+
+const Cfg& C() {
+    static const Cfg cfg = [] {
+        Cfg c;
+        c.fixed = EnvOrSwitch("FUZION_FIXED_STEP", "fixed-step");
+        c.minimized = EnvOrSwitch("FUZION_MINIMIZED", "minimized");
+        c.record = EnvOrOpt("FUZION_RECORD_INPUT", "record-input");
+        c.replay = EnvOrOpt("FUZION_REPLAY_INPUT", "replay-input");
+        c.state_log = EnvOrOpt("FUZION_STATE_LOG", "state-log");
+        c.dump_dir = EnvOrOpt("FUZION_STATE_DUMP", "state-dump");
+        c.dump_region = EnvOrOpt("FUZION_STATE_DUMP_REGION", "state-dump-region");
+        if (const char* v = EnvOrOpt("FUZION_STATE_DUMP_FRAME", "state-dump-frame")) c.dump_frame = std::atoll(v);
+        if (const char* v = EnvOrOpt("FUZION_FRAMES", "frames")) c.frames = std::strtoull(v, nullptr, 10);
+        if (const char* v = EnvOrOpt("FUZION_STALL_MS", "stall-ms")) c.stall_ms = uint32_t(std::strtoul(v, nullptr, 10));
+        if (const char* v = EnvOrOpt("FUZION_SEED", "seed")) {
+            c.have_seed = true;
+            c.seed = uint32_t(std::strtoul(v, nullptr, 0));
+        }
+        return c;
+    }();
+    return cfg;
+}
+
+// 2026-01-01 00:00:00 UTC as 100 ns ticks since 1601-01-01.
+constexpr uint64_t kEpoch100ns = 134116992000000000ull;
+constexpr uint64_t kPerfPerFrame = 3375000ull / 60ull;       // 56250, exactly 1/60 s
+constexpr uint64_t kInterruptPerFrame = 10000000ull / 60ull;  // 166666, 100 ns units
+constexpr uint64_t kRdtscHz = 733333333ull;
+constexpr uint64_t kHashPrime = 0x100000001B3ull;
+constexpr uint64_t kHashBasis = 14695981039346656037ull;
+constexpr uint32_t kAudioFrames = 48000 / 60;  // one sim frame of the mixer
+constexpr int kPorts = 4;
+
+std::atomic<uint64_t> g_frame{0};  // presents, pad index, hash frame
+std::atomic<uint64_t> g_time{0};   // sim ticks. A present costs one. A held clock read costs one.
+std::atomic<uint64_t> g_qpc{0}, g_rdtsc{0}, g_delay{0};
+std::mutex g_time_mu;
+std::condition_variable g_time_cv;
+thread_local bool t_pacer = false;
+bool g_have_qpc = false, g_have_rdtsc = false, g_have_interrupt = false;
+uint64_t g_last_qpc = 0, g_last_rdtsc = 0, g_last_interrupt = 0;
+bool g_logged_spin = false;
+std::mutex g_pad_lock;
+bool g_logged_mode = false;
+bool g_in_present = false;
+
+struct Sample {
+    bool connected = false;
+    uint16_t buttons = 0;
+    uint8_t analog[8] = {};
+    int16_t lx = 0, ly = 0, rx = 0, ry = 0;
+    explicit Sample(const input::Pad& p)
+        : connected(p.connected), buttons(p.buttons), lx(p.lx), ly(p.ly), rx(p.rx), ry(p.ry) {
+        std::memcpy(analog, p.analog, 8);
+    }
+    Sample() = default;
+    input::Pad Pad() const {
+        input::Pad p;
+        p.connected = connected;
+        p.buttons = buttons;
+        std::memcpy(p.analog, analog, 8);
+        p.lx = lx;
+        p.ly = ly;
+        p.rx = rx;
+        p.ry = ry;
+        return p;
+    }
+};
+
+Sample g_latched[kPorts];
+Sample g_pending[kPorts];
+bool g_seen[kPorts] = {};
+std::vector<Sample> g_replay;  // frame-major, 4 ports
+bool g_replay_loaded = false;
+bool g_replay_held = false;
+
+uint32_t g_rng_va = 0;
+FILE* g_state = nullptr;
+bool g_state_header = false;
+
+uint64_t Mix(uint64_t h, uint64_t v) { return (h ^ v) * kHashPrime; }
+
+uint64_t HashBytes(const uint8_t* p, size_t n, uint64_t h) {
+    size_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        uint64_t v;
+        std::memcpy(&v, p + i, 8);
+        h = Mix(h, v);
+    }
+    uint64_t tail = 0;
+    if (i < n) std::memcpy(&tail, p + i, n - i);
+    if (i < n) h = Mix(h, tail);
+    return h;
+}
+
+uint64_t HashZeros(size_t n, uint64_t h) {
+    uint64_t z = 0;
+    while (n >= 8) {
+        h = Mix(h, z);
+        n -= 8;
+    }
+    if (n) h = Mix(h, z);
+    return h;
+}
+
+struct Exc {
+    uint32_t va, end;
+    const char* name;
+};
+
+void AddExc(uint32_t va, uint32_t size, const char* name, void* user) {
+    if (!va || !size) return;
+    static_cast<std::vector<Exc>*>(user)->push_back({va, va + size, name});
+}
+
+bool Overlap(uint32_t a, uint32_t b, const Exc& e) { return a < e.end && e.va < b; }
+
+uint64_t HashVa(uint32_t va, uint32_t size, const std::vector<Exc>& exc, uint64_t h) {
+    uint32_t at = va;
+    const uint32_t end = va + size;
+    while (at < end) {
+        uint32_t run = end;
+        const Exc* hit = nullptr;
+        for (const Exc& e : exc) {
+            if (e.end <= at || e.va >= end) continue;
+            if (e.va <= at) {
+                hit = &e;
+                break;
+            }
+            if (e.va < run) run = e.va;
+        }
+        if (!hit) {
+            h = HashBytes(static_cast<const uint8_t*>(kernel::HostPtr(at)), run - at, h);
+            at = run;
+        } else {
+            uint32_t stop = std::min(hit->end, end);
+            h = HashZeros(stop - at, h);
+            at = stop;
+        }
+    }
+    return h;
+}
+
+void LoadReplay() {
+    if (g_replay_loaded) return;
+    g_replay_loaded = true;
+    const char* path = C().replay;
+    if (!path) return;
+    std::ifstream in(path);
+    if (!in) {
+        LOGE("det: replay file missing: %s", path);
+        kernel::Shutdown(1);
+    }
+    std::string line;
+    while (std::getline(in, line)) {
+        if (line.empty() || line[0] == '#') continue;
+        unsigned frame = 0, port = 0, connected = 0, buttons = 0;
+        int lx = 0, ly = 0, rx = 0, ry = 0;
+        unsigned analog[8] = {};
+        int n = std::sscanf(line.c_str(), "%u %u %u %x %d %d %d %d %x %x %x %x %x %x %x %x", &frame, &port, &connected,
+                            &buttons, &lx, &ly, &rx, &ry, &analog[0], &analog[1], &analog[2], &analog[3], &analog[4],
+                            &analog[5], &analog[6], &analog[7]);
+        if (n != 16 || port < 1 || port > 4) continue;
+        size_t need = (size_t(frame) + 1) * kPorts;
+        if (g_replay.size() < need) g_replay.resize(need);
+        Sample& s = g_replay[size_t(frame) * kPorts + (port - 1)];
+        s.connected = connected != 0;
+        s.buttons = uint16_t(buttons);
+        s.lx = int16_t(lx);
+        s.ly = int16_t(ly);
+        s.rx = int16_t(rx);
+        s.ry = int16_t(ry);
+        for (int i = 0; i < 8; i++) s.analog[i] = uint8_t(analog[i]);
+    }
+    LOGR("det: replay %s, %zu frames", path, g_replay.size() / kPorts);
+}
+
+Sample ReplayAt(uint64_t frame, int port) {
+    LoadReplay();
+    if (g_replay.empty()) return {};
+    uint64_t last = g_replay.size() / kPorts - 1;
+    if (frame > last) {
+        if (!g_replay_held) {
+            g_replay_held = true;
+            LOGR("det: replay held at frame %llu (file ends at %llu)", (unsigned long long)last, (unsigned long long)last);
+        }
+        frame = last;
+    }
+    return g_replay[size_t(frame) * kPorts + port];
+}
+
+void WritePads(uint64_t frame) {
+    if (!C().record) return;
+    static FILE* f = nullptr;
+    static bool opened = false;
+    if (!opened) {
+        opened = true;
+        f = std::fopen(C().record, "w");
+        if (!f) {
+            LOGE("det: cannot write %s", C().record);
+            return;
+        }
+        std::fprintf(f, "# fuzion-input 1\n");
+        std::fprintf(f, "# frame port connected buttons lx ly rx ry a b x y black white lt rt\n");
+        std::fprintf(f, "# ports are 1..4. buttons and analog bytes are hex. sticks are signed.\n");
+    }
+    if (!f) return;
+    for (int p = 0; p < kPorts; p++) {
+        const Sample& s = g_latched[p];
+        std::fprintf(f, "%llu %d %u %04x %d %d %d %d %02x %02x %02x %02x %02x %02x %02x %02x\n", (unsigned long long)frame,
+                     p + 1, s.connected ? 1u : 0u, s.buttons, int(s.lx), int(s.ly), int(s.rx), int(s.ry), s.analog[0],
+                     s.analog[1], s.analog[2], s.analog[3], s.analog[4], s.analog[5], s.analog[6], s.analog[7]);
+    }
+    std::fflush(f);
+}
+
+void LatchNext() {
+    for (int p = 0; p < kPorts; p++) g_latched[p] = g_pending[p];
+}
+
+uint32_t RngNow() {
+    if (!g_rng_va) return 0;
+    return kernel::R32(g_rng_va);
+}
+
+void OpenState() {
+    if (g_state || !C().state_log) return;
+    g_state = std::fopen(C().state_log, "w");
+    if (!g_state) {
+        LOGE("det: cannot write %s", C().state_log);
+        return;
+    }
+}
+
+void StateHeader(const std::vector<Exc>& exc) {
+    if (!g_state || g_state_header) return;
+    g_state_header = true;
+    std::fprintf(g_state, "# det 1\n");
+    std::fprintf(g_state, "# fixed=%d seed=%s stall_ms=%u\n", C().fixed ? 1 : 0, C().have_seed ? "set" : "unset", C().stall_ms);
+    std::fprintf(g_state, "# clock qpc_per_frame=%llu interrupt_100ns_per_frame=%llu rdtsc_per_frame=%llu\n",
+                 (unsigned long long)kPerfPerFrame, (unsigned long long)kInterruptPerFrame,
+                 (unsigned long long)(kRdtscHz / 60ull));
+    std::fprintf(g_state, "# epoch_100ns=%llu rng_global=%08x\n", (unsigned long long)kEpoch100ns, g_rng_va);
+    std::fprintf(g_state, "# excluded from phys (zeroed in the hash):\n");
+    for (const Exc& e : exc)
+        std::fprintf(g_state, "# exclude %08x %08x %s\n", e.va, e.end - e.va, e.name ? e.name : "?");
+    std::fprintf(g_state, "# stacks at D0000000 are not hashed. system is committed pages at B0000000.\n");
+    std::fprintf(g_state, "# user slices are 4MB from 00000000 through 7FFE0000. index 0 starts at 00010000.\n");
+    std::fprintf(g_state, "# F frame total data phys system user seed qpc rdtsc delay\n");
+    std::fprintf(g_state, "# P frame 64 hashes of 1MB physical slices from 80000000\n");
+    std::fprintf(g_state, "# D frame section=hash. U frame index=hash for committed user slices.\n");
+}
+
+void DumpRegion(uint64_t frame, const char* name, uint32_t va, uint32_t size, const std::vector<Exc>& exc) {
+    const Cfg& c = C();
+    if (!c.dump_dir || c.dump_frame < 0 || uint64_t(c.dump_frame) != frame) return;
+    if (c.dump_region && c.dump_region[0] && std::strcmp(c.dump_region, name) != 0) return;
+    std::string path = std::string(c.dump_dir) + "/frame_" + std::to_string(frame) + "_" + name + ".bin";
+    FILE* f = std::fopen(path.c_str(), "wb");
+    if (!f) {
+        LOGE("det: cannot write %s", path.c_str());
+        return;
+    }
+    std::vector<uint8_t> buf(4096);
+    for (uint32_t at = va; at < va + size;) {
+        uint32_t n = std::min<uint32_t>(4096, va + size - at);
+        bool gap = false;
+        for (const Exc& e : exc)
+            if (Overlap(at, at + n, e)) gap = true;
+        if (gap || !mem::IsCommitted(at)) std::memset(buf.data(), 0, n);
+        else std::memcpy(buf.data(), kernel::HostPtr(at), n);
+        std::fwrite(buf.data(), 1, n, f);
+        at += n;
+    }
+    std::fclose(f);
+    LOGR("det: dumped %s", path.c_str());
+}
+
+void WriteState(uint64_t frame) {
+    OpenState();
+    std::vector<Exc> exc;
+    d3d::VolatileSpans(AddExc, &exc);
+    std::sort(exc.begin(), exc.end(), [](const Exc& a, const Exc& b) { return a.va < b.va; });
+    StateHeader(exc);
+
+    uint64_t data_h = kHashBasis;
+    if (kernel::g_image) {
+        if (g_state) std::fprintf(g_state, "D %llu", (unsigned long long)frame);
+        for (const xbe::Section& s : kernel::g_image->sections) {
+            if (!(s.flags & xbe::kWritable) || !s.vsize) continue;
+            uint64_t h = HashVa(s.va, s.vsize, exc, kHashBasis);
+            data_h = Mix(data_h, h);
+            if (g_state) std::fprintf(g_state, " %s=%016llx", s.name.c_str(), (unsigned long long)h);
+            DumpRegion(frame, s.name.c_str(), s.va, s.vsize, exc);
+        }
+        if (g_state) std::fprintf(g_state, "\n");
+    }
+
+    uint64_t phys_h = kHashBasis;
+    uint64_t slices[64];
+    for (int i = 0; i < 64; i++) {
+        uint32_t va = 0x80000000u + uint32_t(i) * 0x100000u;
+        slices[i] = HashVa(va, 0x100000u, exc, kHashBasis);
+        phys_h = Mix(phys_h, slices[i]);
+        char name[16];
+        std::snprintf(name, sizeof name, "phys_%02d", i);
+        DumpRegion(frame, name, va, 0x100000u, exc);
+    }
+
+    uint64_t system_h = kHashBasis;
+    for (uint32_t va = mem::kSystemBase; va < mem::kSystemBase + mem::kSystemSize; va += mem::kPage) {
+        if (!mem::IsCommitted(va)) continue;
+        system_h = Mix(system_h, va);
+        system_h = HashBytes(static_cast<const uint8_t*>(kernel::HostPtr(va)), mem::kPage, system_h);
+    }
+    if (C().dump_region && std::strcmp(C().dump_region, "system") == 0)
+        DumpRegion(frame, "system", mem::kSystemBase, mem::kSystemSize, {});
+
+    // The whole user window, not only addresses above the image. Early heap sits just past .data.
+    uint64_t user_h = kHashBasis;
+    std::string user_line;
+    for (uint32_t base = 0; base < mem::kUserHigh; base += 0x400000u) {
+        uint32_t from = std::max(base, mem::kUserLow);
+        uint32_t to = std::min(base + 0x400000u, mem::kUserHigh);
+        bool any = false;
+        uint64_t h = kHashBasis;
+        for (uint32_t va = from; va < to; va += mem::kPage) {
+            if (!mem::IsCommitted(va)) continue;
+            any = true;
+            h = Mix(h, va);
+            h = HashBytes(static_cast<const uint8_t*>(kernel::HostPtr(va)), mem::kPage, h);
+        }
+        if (!any) continue;
+        user_h = Mix(user_h, h);
+        uint32_t index = base / 0x400000u;
+        char piece[64];
+        std::snprintf(piece, sizeof piece, " %u=%016llx", index, (unsigned long long)h);
+        user_line += piece;
+        char name[16];
+        std::snprintf(name, sizeof name, "user_%u", index);
+        if (C().dump_region && std::strcmp(C().dump_region, name) == 0) DumpRegion(frame, name, from, to - from, {});
+    }
+
+    uint64_t total = kHashBasis;
+    total = Mix(total, data_h);
+    total = Mix(total, phys_h);
+    total = Mix(total, system_h);
+    total = Mix(total, user_h);
+    uint32_t seed = RngNow();
+    if (g_state) {
+        std::fprintf(g_state, "P %llu", (unsigned long long)frame);
+        for (uint64_t s : slices) std::fprintf(g_state, " %016llx", (unsigned long long)s);
+        std::fprintf(g_state, "\n");
+        if (!user_line.empty()) std::fprintf(g_state, "U %llu%s\n", (unsigned long long)frame, user_line.c_str());
+        std::fprintf(g_state,
+                     "F %llu total=%016llx data=%016llx phys=%016llx system=%016llx user=%016llx seed=%08x qpc=%llu "
+                     "rdtsc=%llu delay=%llu\n",
+                     (unsigned long long)frame, (unsigned long long)total, (unsigned long long)data_h,
+                     (unsigned long long)phys_h, (unsigned long long)system_h, (unsigned long long)user_h, seed,
+                     (unsigned long long)g_qpc.load(), (unsigned long long)g_rdtsc.load(),
+                     (unsigned long long)g_delay.load());
+        std::fflush(g_state);
+    }
+    static uint32_t last_seed = 0;
+    static bool have_last = false;
+    if (!have_last || seed != last_seed) {
+        LOGR("det: rng seed at frame %llu is %08x", (unsigned long long)frame, seed);
+        last_seed = seed;
+        have_last = true;
+    }
+    if ((frame % 60ull) == 0)
+        LOGR("det: frame %llu total %016llx seed %08x", (unsigned long long)frame, (unsigned long long)total, seed);
+}
+
+void LogMode() {
+    if (g_logged_mode) return;
+    g_logged_mode = true;
+    const Cfg& c = C();
+    LOGR("det: fixed=%d record=%s replay=%s frames=%llu stall_ms=%u seed=%s state=%s", c.fixed ? 1 : 0,
+         c.record ? c.record : "-", c.replay ? c.replay : "-", (unsigned long long)c.frames, c.stall_ms,
+         c.have_seed ? "set" : "unset", c.state_log ? c.state_log : "-");
+    if (c.fixed) {
+        LOGR("det: clocks are frame-derived (qpc +%llu, interrupt +%llu 100ns, rdtsc +%llu, tick ms = frame*1000/60)",
+             (unsigned long long)kPerfPerFrame, (unsigned long long)kInterruptPerFrame,
+             (unsigned long long)(kRdtscHz / 60ull));
+        LOGR("det: presenter KeDelay yields the guest turn, vblank advances on present, mixer advances %u samples",
+             kAudioFrames);
+    }
+}
+
+}  // namespace
+
+void SetArgs(int argc, char** argv) {
+    g_argc = argc;
+    g_argv = argv;
+}
+
+bool FixedStep() { return C().fixed; }
+bool Recording() { return C().record != nullptr; }
+bool Replaying() { return C().replay != nullptr; }
+bool Minimized() { return C().minimized; }
+bool FramePads() { return C().fixed || C().record || C().replay; }
+
+void NoteQpc() { g_qpc.fetch_add(1, std::memory_order_relaxed); }
+void NoteRdtsc() { g_rdtsc.fetch_add(1, std::memory_order_relaxed); }
+void NoteDelay() { g_delay.fetch_add(1, std::memory_order_relaxed); }
+
+uint64_t PerfCounter() { return g_time.load(std::memory_order_relaxed) * kPerfPerFrame; }
+uint64_t InterruptTime100ns() { return g_time.load(std::memory_order_relaxed) * kInterruptPerFrame; }
+uint64_t SystemTime100ns() { return kEpoch100ns + InterruptTime100ns(); }
+uint64_t Rdtsc() { return g_time.load(std::memory_order_relaxed) * (kRdtscHz / 60ull); }
+uint32_t TickMs() { return uint32_t((g_time.load(std::memory_order_relaxed) * 1000ull) / 60ull); }
+
+void PublishTime() {
+    uint64_t t = g_time.load(std::memory_order_relaxed);
+    kernel::SetDeterministicClocks(t * kInterruptPerFrame, kEpoch100ns + t * kInterruptPerFrame,
+                                   uint32_t((t * 1000ull) / 60ull));
+}
+
+void AdvanceTicksLocked(uint64_t ticks) {
+    if (!ticks) return;
+    g_time.fetch_add(ticks, std::memory_order_relaxed);
+    PublishTime();
+    g_time_cv.notify_all();
+}
+
+uint64_t Hold(uint64_t& last, bool& have, uint64_t now) {
+    if (have && now == last) {
+        if (!g_logged_spin) {
+            g_logged_spin = true;
+            LOGR("det: a clock read repeated, so the sim tick advanced. The title waits on QPC for frequency/2.");
+        }
+        AdvanceTicksLocked(1);
+        now = g_time.load(std::memory_order_relaxed);
+    }
+    have = true;
+    return now;
+}
+
+uint64_t ClockQpc() {
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    uint64_t ticks = Hold(g_last_qpc, g_have_qpc, g_time.load(std::memory_order_relaxed));
+    g_last_qpc = ticks;
+    return ticks * kPerfPerFrame;
+}
+
+uint64_t ClockRdtsc() {
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    uint64_t ticks = Hold(g_last_rdtsc, g_have_rdtsc, g_time.load(std::memory_order_relaxed));
+    g_last_rdtsc = ticks;
+    return ticks * (kRdtscHz / 60ull);
+}
+
+uint64_t ClockInterrupt() {
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    uint64_t ticks = Hold(g_last_interrupt, g_have_interrupt, g_time.load(std::memory_order_relaxed));
+    g_last_interrupt = ticks;
+    return ticks * kInterruptPerFrame;
+}
+
+uint64_t ClockSystem() { return kEpoch100ns + ClockInterrupt(); }
+
+void Consume100ns(uint64_t hundred_ns) {
+    if (!hundred_ns) return;
+    uint64_t ticks = hundred_ns / kInterruptPerFrame;
+    if (!ticks) return;
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    AdvanceTicksLocked(ticks);
+}
+
+void NotePacer() { t_pacer = true; }
+bool OnPacer() { return t_pacer; }
+
+void WaitTicks(uint64_t ticks) {
+    if (!ticks) ticks = 1;
+    std::unique_lock<std::mutex> lock(g_time_mu);
+    uint64_t deadline = g_time.load(std::memory_order_relaxed) + ticks;
+    g_time_cv.wait(lock, [&] { return g_time.load(std::memory_order_relaxed) >= deadline; });
+}
+
+uint64_t WholeTicks(uint64_t hundred_ns) { return hundred_ns / kInterruptPerFrame; }
+
+// One thread holds the turn (g_busy). Waiters queue on g_waiting. A yield clears the turn
+// and waits until every other thread has gone back to a kernel wait, and until alertable
+// APCs queued while a thread was waiting have been popped. Ticket numbers are not used:
+// a counter that moves past a waiter leaves both threads blocked in UnblockGuest.
+std::mutex g_sched_mu;
+std::condition_variable g_sched_cv;
+int g_busy = 0;
+int g_waiting = 0;
+std::atomic<int> g_deliverable{0};
+std::atomic<uint64_t> g_handoffs{0};
+thread_local int t_guest_depth = 0;
+thread_local bool t_guest_hold = false;
+bool g_logged_yield = false;
+
+void NoteDeliverable(int delta) {
+    if (!delta || !FixedStep()) return;
+    g_deliverable.fetch_add(delta, std::memory_order_acq_rel);
+    g_sched_cv.notify_all();
+}
+
+void AcquireTurn() {
+    std::unique_lock<std::mutex> lock(g_sched_mu);
+    if (g_busy) {
+        g_waiting++;
+        g_sched_cv.wait(lock, [] { return g_busy == 0; });
+        g_waiting--;
+    }
+    g_busy = 1;
+    t_guest_hold = true;
+}
+
+void ReleaseTurn() {
+    std::lock_guard<std::mutex> lock(g_sched_mu);
+    if (!t_guest_hold) return;
+    t_guest_hold = false;
+    g_busy = 0;
+    g_handoffs.fetch_add(1, std::memory_order_relaxed);
+    g_sched_cv.notify_all();
+}
+
+void EnterGuest() {
+    if (!FixedStep()) return;
+    if (t_guest_depth++ > 0) return;
+    AcquireTurn();
+}
+
+void LeaveGuest() {
+    if (!FixedStep()) return;
+    if (t_guest_depth == 0) return;
+    if (--t_guest_depth > 0) return;
+    ReleaseTurn();
+}
+
+void BlockGuest() {
+    if (!FixedStep() || !t_guest_hold) return;
+    ReleaseTurn();
+}
+
+void UnblockGuest() {
+    if (!FixedStep() || t_guest_depth == 0 || t_guest_hold) return;
+    AcquireTurn();
+}
+
+void AbandonGuest() {
+    if (!FixedStep() || t_guest_depth == 0) return;
+    t_guest_depth = 0;
+    if (!t_guest_hold) return;
+    LOGR("det: a guest thread exited while it held the turn; the turn is released");
+    ReleaseTurn();
+}
+
+void YieldGuest() {
+    if (!FixedStep() || !t_guest_hold) return;
+    if (!g_logged_yield) {
+        g_logged_yield = true;
+        LOGR("det: presenter yield runs other guest threads until they block");
+    }
+    std::unique_lock<std::mutex> lock(g_sched_mu);
+    t_guest_hold = false;
+    g_busy = 0;
+    g_sched_cv.notify_all();
+    kernel::SignalChanged();
+    // While an alertable APC is still queued, g_deliverable stays above zero, so the
+    // loader claims g_busy and pops it before this wait can return.
+    g_sched_cv.wait(lock, [] {
+        return g_busy == 0 && g_waiting == 0 && g_deliverable.load(std::memory_order_acquire) == 0;
+    });
+    g_busy = 1;
+    t_guest_hold = true;
+}
+
+void PacerDelay(uint64_t hundred_ns) {
+    if (hundred_ns) Consume100ns(hundred_ns);
+    uint64_t before = g_handoffs.load(std::memory_order_relaxed);
+    YieldGuest();
+    if (!hundred_ns || hundred_ns >= kInterruptPerFrame) return;
+    if (g_handoffs.load(std::memory_order_relaxed) != before) return;
+    std::lock_guard<std::mutex> lock(g_time_mu);
+    AdvanceTicksLocked(1);
+}
+
+void WatchRng(uint32_t guest_va) { g_rng_va = guest_va; }
+
+void OnImageLoaded() {
+    if (!C().fixed && !C().have_seed && !C().record && !C().replay && !C().state_log) return;
+    LogMode();
+    if (!g_rng_va) return;
+    uint32_t cur = kernel::R32(g_rng_va);
+    LOGR("det: rng global %08x holds %08x at image load", g_rng_va, cur);
+    if (C().have_seed) {
+        kernel::W32(g_rng_va, C().seed);
+        LOGR("det: rng global %08x forced to %08x (a later srand can replace it; the frame log shows that)", g_rng_va,
+             C().seed);
+    }
+}
+
+void FilterPad(int port, input::Pad& pad) {
+    if (port < 0 || port >= kPorts) return;
+    std::lock_guard<std::mutex> lock(g_pad_lock);
+    if (C().replay) {
+        pad = ReplayAt(g_frame.load(std::memory_order_relaxed), port).Pad();
+        return;
+    }
+    if (C().record || C().fixed) {
+        g_pending[port] = Sample(pad);
+        if (!g_seen[port]) {
+            g_latched[port] = g_pending[port];
+            g_seen[port] = true;
+        }
+        pad = g_latched[port].Pad();
+    }
+}
+
+void OnPresented(X86Context& ctx) {
+    const Cfg& c = C();
+    if (!c.fixed && !c.record && !c.replay && !c.state_log && !c.frames && !c.stall_ms) return;
+    if (g_in_present) return;
+    g_in_present = true;
+    NotePacer();
+    LogMode();
+    if (c.stall_ms) std::this_thread::sleep_for(std::chrono::milliseconds(c.stall_ms));
+    if (FramePads()) xapi::PollPortsOnce();
+    if (c.fixed) dsound::AdvanceFixed(ctx, kAudioFrames);
+    if (c.fixed) kernel::FireDueTimers(ctx);
+
+    uint64_t frame = g_frame.load(std::memory_order_relaxed);
+    if (c.state_log || c.dump_dir) WriteState(frame);
+    {
+        std::lock_guard<std::mutex> lock(g_pad_lock);
+        if (c.record) WritePads(frame);
+        if (c.record || c.fixed) LatchNext();
+    }
+    uint64_t next = frame + 1;
+    g_frame.store(next, std::memory_order_relaxed);
+    if (c.fixed) {
+        std::lock_guard<std::mutex> lock(g_time_mu);
+        AdvanceTicksLocked(1);
+        d3d::BumpVblank();
+    }
+    g_in_present = false;
+    if (c.frames && next >= c.frames) {
+        if (g_state) std::fflush(g_state);
+        LOGR("det: reached %llu frames", (unsigned long long)c.frames);
+        kernel::Shutdown(0);
+    }
+}
+
+}  // namespace det
