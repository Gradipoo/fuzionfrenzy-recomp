+             double(f.c98), double(f.c121), double(f.x), double(f.y));
+    }
+    g_smallRt.clear();
+}
+void AccumSmallRt(uint32_t gw, uint32_t gh, uint32_t rtData, float dx, const State& s, const Assembled& a, const DrawShaders& sh) {
+    SmallRt& f = g_smallRt[rtData];
+    if (!f.draws) {
+        f.gw = gw;
+        f.gh = gh;
+        f.dx = dx;
+        f.vp[0] = s.viewport.x;
+        f.vp[1] = s.viewport.y;
+        f.vp[2] = s.viewport.w;
+        f.vp[3] = s.viewport.h;
+        f.cop = s.tss[0][kTssColorOp];
+        f.c97 = s.vsc[97][0];
+        f.c98 = s.vsc[98][0];
+        f.c121 = s.vsc[121][3];
+    }
+    f.draws++;
+    if (!f.sampled && sh.prog && s.vs && a.vertex_count) {
+        float in[16][4] = {}, out[16][4] = {};
+        for (int r = 0; r < 16; r++)
+            if ((a.regs >> r) & 1) ReadVertexRegister(a, r, 0, in[r]);
+        std::vector<int> reads;
+        EvalVertexProgram(s.vs->program, a.regs, in, s.vsc, out, reads);
+        f.x = out[0][0];
+        f.y = out[0][1];
+        f.sampled = true;
+    }
+}
