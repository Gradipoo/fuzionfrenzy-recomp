+
+// Countdown ticks flash the real character and floor textures for one frame. Log a character or
+// floor draw only when its bindings change, and log an off-screen pass only when the place it
+// draws changes, so the white frame and that flash can be diffed.
+struct FlickerSig {
+    uint32_t data[4], fmt[4], cop[4], arg[4], rt;
+    uint32_t fogEn, fogc, blend, src, dst, tf, vp;
+};
+int Milli(float v) { return int(std::lround(double(v) * 1000.0)); }
+FlickerSig MakeFlickerSig(const State& s, const DrawTextures& stages) {
+    FlickerSig g{};
+    for (int i = 0; i < 4; i++) {
+        const auto& ts = s.tss[size_t(i)];
+        g.data[i] = stages.hasDesc[i] ? stages.desc[i].data : 0;
+        g.fmt[i] = stages.hasDesc[i] ? stages.desc[i].format | (stages.desc[i].width << 8) | (stages.desc[i].height << 20) : 0;
+        g.cop[i] = ts[kTssColorOp];
+        g.arg[i] = ts[kTssColorArg1] | (ts[kTssColorArg2] << 8) | (ts[kTssAlphaOp] << 16);
+        if (stages.rt[i]) g.rt |= 1u << i;
+    }
+    g.fogEn = s.rs[kRsFogEnable];
+    g.fogc = s.rs[kRsFogColor];
+    g.blend = SimpleState(s, kMBlendEnable);
+    g.src = SimpleState(s, kMSrcBlend);
+    g.dst = SimpleState(s, kMDestBlend);
+    g.tf = s.rs[kRsTextureFactor];
+    g.vp = s.viewport.x | (s.viewport.y << 8) | (s.viewport.w << 16);
+    return g;
+}
+void NoteFlicker(uint64_t present, uint32_t gw, uint32_t gh, float dx, const State& s, const Assembled& a, const DrawShaders& sh, const DrawTextures& stages) {
+    static std::unordered_map<uint32_t, FlickerSig> seen;
+    static int lines = 0;
+    if (lines > 200) return;
+    uint32_t verts = std::max(a.vertex_count, a.index_count);
+    const bool tex = stages.hasDesc[0] && stages.info[0].kind;
+    const uint32_t fmt = tex ? stages.desc[0].format : 0;
+    const bool isChar = sh.prog && fmt == 0x02 && verts < 80 && s.tss[0][kTssColorOp] >= 4;
+    const bool isFloor = !sh.prog && verts >= 2000 && tex;
+    if (!isChar && !isFloor) return;
+    FlickerSig g = MakeFlickerSig(s, stages);
+    uint32_t key = s.vs_handle ^ g.data[0] ^ (isFloor ? 0x10000u : 0u);
+    auto it = seen.find(key);
+    if (it != seen.end() && std::memcmp(&it->second, &g, sizeof(g)) == 0) return;
+    seen[key] = g;
+    lines++;
+    std::string st;
+    for (int i = 0; i < 4; i++) {
+        char b[120];
+        std::snprintf(b, sizeof(b), " s%d{cop=%u a=%u/%u hdr=%08X data=%08X rt=%d fmt=%02X %ux%u}", i, g.cop[i], g.arg[i] & 0xFF, (g.arg[i] >> 8) & 0xFF,
+                      s.textures[size_t(i)], g.data[i], int((g.rt >> i) & 1), stages.hasDesc[i] ? stages.desc[i].format : 0,
+                      stages.hasDesc[i] ? stages.desc[i].width : 0, stages.hasDesc[i] ? stages.desc[i].height : 0);
+        st += b;
+    }
+    LOGR("texdiag flip %s p=%llu v=%u vs=%08X rt=%ux%u dx=%.1f fog_en=%u fogc=%08X blend=%u src=%X dst=%X tf=%08X vp=(%u,%u %ux%u) c97=%.3f c98=%.3f c121w=%.3f%s",
+         isChar ? "char" : "floor", (unsigned long long)present, verts, s.vs_handle, gw, gh, double(dx), g.fogEn, g.fogc, g.blend, g.src, g.dst, g.tf,
+         s.viewport.x, s.viewport.y, s.viewport.w, s.viewport.h, double(s.vsc[97][0]), double(s.vsc[98][0]), double(s.vsc[121][3]), st.c_str());
+}
+struct SmallRt {
+    uint32_t draws = 0, gw = 0, gh = 0, vp[4] = {}, cop = 0, fmt = 0;
+    float dx = 0, c97 = 0, c98 = 0, c121 = 0, x = 0, y = 0;
+    bool sampled = false;
+};
+std::unordered_map<uint32_t, SmallRt> g_smallRt;
+std::unordered_map<uint32_t, uint64_t> g_smallRtSig;
+int g_smallRtLines = 0;
+void FlushSmallRt(uint64_t present) {
+    if (present == ~uint64_t{0}) { g_smallRt.clear(); return; }
+    for (const auto& [data, f] : g_smallRt) {
+        if (g_smallRtLines > 120) break;
+        uint64_t sig = (uint64_t(f.draws / 8) << 48) ^ (uint64_t(std::lround(f.x)) << 32) ^ (uint64_t(std::lround(f.y)) << 20) ^
+                       (uint64_t(Milli(f.c98)) << 4) ^ f.vp[2] ^ (uint64_t(f.gw) << 40);
+        if (g_smallRtSig[data] == sig) continue;
+        g_smallRtSig[data] = sig;
+        g_smallRtLines++;
+        LOGR("texdiag rtpass p=%llu rt=%08X %ux%u draws=%u dx=%.1f vp=(%u,%u %ux%u) cop=%u fmt=%02X c97=%.3f c98=%.3f c121w=%.3f pos=(%.1f,%.1f)",
