+// Frame-derived clocks, latched pads, and a per-present guest RAM checksum.
+// Off unless a flag or env var is set. See docs/netplay-determinism.md.
+#include "core/determinism.h"
+
+#include "core/input.h"
+#include "core/log.h"
+#include "kernel/kernel.h"
+#include "kernel/memory.h"
+#include "xbe/xbe.h"
