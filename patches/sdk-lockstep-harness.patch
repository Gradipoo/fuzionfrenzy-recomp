 uint64_t Mix(uint64_t h, uint64_t v) { return (h ^ v) * kHashPrime; }
 
+// ARM invalid-ops produce the default NaN. x86 keeps a payload. A quiet NaN is
+// hashed as the default quiet NaN (sign kept) so the two hosts match. Guest RAM
+// is not rewritten. An integer whose bits happen to be a NaN is hashed the same
+// way; pages are 4-byte aligned, and only complete 4- and 8-byte groups are looked at.
+uint32_t CanonF32(uint32_t v) {
+    if (((v >> 23) & 0xFFu) == 0xFFu && (v & 0x7FFFFFu) != 0) return (v & 0x80000000u) | 0x7FC00000u;
+    return v;
+}
+uint64_t CanonWord(uint64_t v) {
+    if (((v >> 52) & 0x7FFu) == 0x7FFu && (v & 0x000FFFFFFFFFFFFFull) != 0)
+        return (v & 0x8000000000000000ull) | 0x7FF8000000000000ull;
+    uint32_t lo = CanonF32(uint32_t(v));
+    uint32_t hi = CanonF32(uint32_t(v >> 32));
+    return uint64_t(lo) | (uint64_t(hi) << 32);
+}
+
 uint64_t HashBytes(const uint8_t* p, size_t n, uint64_t h) {
