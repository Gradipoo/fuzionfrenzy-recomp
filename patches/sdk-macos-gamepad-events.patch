+void NoteDevice(uint32_t event_type, uint32_t joystick_id) {
+    if (!g_sdl) return;
+    std::lock_guard lock(g_lock);
+    if (event_type == SDL_EVENT_GAMEPAD_ADDED) AddPad(joystick_id);
+    else if (event_type == SDL_EVENT_GAMEPAD_REMOVED) RemovePad(joystick_id);
