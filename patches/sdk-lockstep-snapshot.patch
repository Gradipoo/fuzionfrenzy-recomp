+bool SnapshotInstallRanges(const uint8_t* p, size_t n) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    EnsureRanges();
+    const uint8_t* q = p;
+    const uint8_t* end = p + n;
+    if (!g_contig.ReadMaps(q, end) || !g_system.ReadMaps(q, end) || !g_stacks.ReadMaps(q, end) || !g_user.ReadMaps(q, end))
+        return false;
+    if (q + 4 > end) return false;
+    uint32_t count = 0;
+    std::memcpy(&count, q, 4);
+    q += 4;
+    if (count > 1000000 || q + size_t(count) * 8 > end) return false;
+    g_stack_tops.clear();
+    for (uint32_t i = 0; i < count; i++) {
+        uint32_t k = 0, v = 0;
+        std::memcpy(&k, q, 4);
+        std::memcpy(&v, q + 4, 4);
+        q += 8;
+        g_stack_tops[k] = v;
+    }
+    if (q + 4 > end) return false;
+    std::memcpy(&count, q, 4);
+    q += 4;
+    if (count > 1000000) return false;
+    std::map<uint32_t, Reservation> reserved;
+    for (uint32_t i = 0; i < count; i++) {
+        if (q + 16 > end) return false;
+        uint32_t k = 0, size = 0, protect = 0, cn = 0;
+        std::memcpy(&k, q, 4);
+        std::memcpy(&size, q + 4, 4);
