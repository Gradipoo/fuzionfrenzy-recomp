--- /dev/null
+++ b/runtime/app/text_input.h
@@ -0,0 +1,43 @@
+#pragma once
+// SDL text input and the clipboard talk to AppKit. Those calls belong on the
+// window thread. The render thread only records a request.
+#include <SDL3/SDL.h>
+
+#include <mutex>
+
+namespace app {
+
+struct TextInputQueue {
+    void Want(bool visible, int x, int y, int h) {
+        std::lock_guard<std::mutex> lock(mu_);
+        op_ = visible ? 2 : 1;
+        area_.x = x;
+        area_.y = y;
+        area_.w = 1;
+        area_.h = h > 0 ? h : 1;
+    }
+    // Window thread. A request from another thread is applied here.
+    void Apply(SDL_Window* window) {
+        int op = 0;
+        SDL_Rect area{};
+        {
+            std::lock_guard<std::mutex> lock(mu_);
+            op = op_;
+            op_ = 0;
+            area = area_;
+        }
+        if (!window || !op) return;
+        if (op == 1) SDL_StopTextInput(window);
+        else {
+            SDL_SetTextInputArea(window, &area, 0);
+            SDL_StartTextInput(window);
+        }
+    }
+
+private:
+    std::mutex mu_;
+    int op_ = 0;
+    SDL_Rect area_{};
+};
+
+}  // namespace app
