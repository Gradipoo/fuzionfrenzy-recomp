new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/runtime/cpu/softmath.h
@@ -0,0 +1,62 @@
+#pragma once
+// Guest-visible math. Transcendentals are openlibm (third_party/openlibm),
+// compiled once with contraction off. sqrt and the rounding builtins stay on
+// the hardware: IEEE-754 requires those to be correctly rounded.
+// x87 FSIN/FCOS/FPTAN are not the CRT sin: they use openlibm plus the 66-bit
+// pi reduction the x87 actually uses. 80-bit memory is integer arithmetic.
+// XBE_LOCKSTEP_FP
+
+#include <cstdint>
+
+double xbe_sin(double);
+double xbe_cos(double);
+double xbe_tan(double);
+double xbe_asin(double);
+double xbe_acos(double);
+double xbe_atan(double);
+double xbe_atan2(double y, double x);
+double xbe_log(double);
+double xbe_log2(double);
+double xbe_log10(double);
+double xbe_exp(double);
+double xbe_exp2(double);
+double xbe_pow(double x, double y);
+double xbe_fmod(double x, double y);
+double xbe_remainder(double x, double y);
+double xbe_ldexp(double v, int exp);
+double xbe_frexp(double v, int* exp);
+
+float xbe_sinf(float);
+float xbe_cosf(float);
+float xbe_log2f(float);
+float xbe_exp2f(float);
+float xbe_powf(float x, float y);
+
+// x87 transcendentals. |x| >= 2^63 is reported by the caller via C2; these
+// assume the operand was accepted. PC does not narrow them.
+double xbe_x87_sin(double);
+double xbe_x87_cos(double);
+void xbe_x87_sincos(double x, double* s, double* c);
+double xbe_x87_tan(double);
+
+// 24-bit precision control. Rounds the significand only, so a value outside
+// the float range stays finite instead of becoming inf or zero.
+double xbe_round24(double);
+
+// Float-to-int the way CVTSS2SI does: out of range, NaN, and infinities are
+// the integer indefinite 0x80000000. The cast itself only sees an in-range
+// value, so ARM's saturating convert is not used.
+int32_t xbe_cvt_i32(double rounded);
+// Truncate to a bounded int for FSCALE. Huge exponents clamp instead of
+// becoming an undefined float-to-int cast.
+int xbe_trunc_i32(double v);
+
+// 80-bit memory format. Registers in this recomp stay IEEE binary64. The
+// conversion is integer arithmetic, so it does not follow host long double.
+double xbe_load80(const uint8_t* p);
+void xbe_store80(uint8_t* p, double v);
+
+// Round to nearest even, no flush-to-zero, no denormals-are-zero.
+// The recompiled SSE/x87 arithmetic uses the host unit and does not consult
+// the guest MXCSR, so every thread is held to this mode.
+void xbe_arm_host_fp();
diff --git a/runtime/cpu/softmath.cpp b/runtime/cpu/softmath.cpp
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/runtime/cpu/softmath.cpp
@@ -0,0 +1,340 @@
+// Guest math. Transcendentals are openlibm under an olm_ prefix.
+// ldexp, frexp, and the 80-bit memory format stay integer arithmetic so they
+// do not follow host long double. sqrt stays a hardware instruction at the
+// call site (FSQRT). XBE_LOCKSTEP_FP
+#include "cpu/softmath.h"
+
+#include <cfloat>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+#if defined(_MSC_VER)
+#include <xmmintrin.h>
+#endif
+
+#if defined(__clang__)
+#pragma clang fp contract(off)
+#endif
+#pragma STDC FP_CONTRACT OFF
+
+static_assert(FLT_EVAL_METHOD == 0 || FLT_EVAL_METHOD == -1,
+              "float and double must evaluate in their own precision, not x87 80-bit");
+
+extern "C" {
+double olm_sin(double);
+double olm_cos(double);
+double olm_tan(double);
+double olm_asin(double);
+double olm_acos(double);
+double olm_atan(double);
+double olm_atan2(double, double);
+double olm_log(double);
+double olm_log10(double);
+double olm_log2(double);
+double olm_exp(double);
+double olm_exp2(double);
+double olm_pow(double, double);
+double olm_fmod(double, double);
+double olm_remainder(double, double);
+float olm_sinf(float);
+float olm_cosf(float);
+float olm_log2f(float);
+float olm_exp2f(float);
+float olm_powf(float, float);
+}
+
+namespace {
+
+constexpr double kInf = std::numeric_limits<double>::infinity();
+
+double Bits(uint64_t u) {
+    double d;
+    std::memcpy(&d, &u, 8);
+    return d;
+}
+
+uint64_t BitsOf(double d) {
+    uint64_t u;
+    std::memcpy(&u, &d, 8);
+    return u;
+}
+
+bool IsNan(double x) { return x != x; }
+bool IsInf(double x) { return x == kInf || x == -kInf; }
+
+double Copysign(double x, double s) {
+    uint64_t u = BitsOf(x);
+    uint64_t t = BitsOf(s);
+    u = (u & 0x7fffffffffffffffull) | (t & 0x8000000000000000ull);
+    return Bits(u);
+}
+
+int Normalize80(uint64_t& mant) {
+    int sh = 0;
+    if (mant == 0) return 0;
+    while ((mant & 0x8000000000000000ull) == 0) {
+        mant <<= 1;
+        sh++;
+    }
+    return sh;
+}
+
+
+}  // namespace
+
+double xbe_sin(double x) { return olm_sin(x); }
+double xbe_cos(double x) { return olm_cos(x); }
+double xbe_tan(double x) { return olm_tan(x); }
+double xbe_asin(double x) { return olm_asin(x); }
+double xbe_acos(double x) { return olm_acos(x); }
+double xbe_atan(double x) { return olm_atan(x); }
+double xbe_atan2(double y, double x) { return olm_atan2(y, x); }
+double xbe_log(double x) { return olm_log(x); }
+double xbe_log2(double x) { return olm_log2(x); }
+double xbe_log10(double x) { return olm_log10(x); }
+double xbe_exp(double x) { return olm_exp(x); }
+double xbe_exp2(double x) { return olm_exp2(x); }
+double xbe_pow(double x, double y) { return olm_pow(x, y); }
+double xbe_fmod(double x, double y) { return olm_fmod(x, y); }
+double xbe_remainder(double x, double y) { return olm_remainder(x, y); }
+
+float xbe_sinf(float x) { return olm_sinf(x); }
+float xbe_cosf(float x) { return olm_cosf(x); }
+float xbe_log2f(float x) { return olm_log2f(x); }
+float xbe_exp2f(float x) { return olm_exp2f(x); }
+float xbe_powf(float x, float y) { return olm_powf(x, y); }
+
+// 66-bit pi, 0xC90FDAA22168C234C * 2^-66. fsin reduces with this, not true pi.
+// xboxrecomp recomp_x87_sincos_pi66 (MIT). Below pi/4 there is no reduction.
+constexpr double kPi66D = 0x1.8518e2da2e893p-70;
+constexpr double kPi4 = 0x1.921fb54442d18p-1;
+
+bool X87Reduces(double x) { return std::isfinite(x) && std::fabs(x) > kPi4; }
+
+void X87SinCosPi66(double x, double* s, double* c) {
+    double e = x * kPi66D;
+    double sx = olm_sin(x);
+    double cx = olm_cos(x);
+    double se, v;
+    if (std::fabs(e) < 0x1p-26) {
+        se = e;
+        v = 0.0;
+    } else {
+        double h = olm_sin(0.5 * e);
+        se = olm_sin(e);
+        v = 2.0 * h * h;
+    }
+    *s = sx + (cx * se - sx * v);
+    *c = cx - (sx * se + cx * v);
+}
+
+double xbe_x87_sin(double x) {
+    if (!X87Reduces(x)) return olm_sin(x);
+    double s, c;
+    X87SinCosPi66(x, &s, &c);
+    return s;
+}
+
+double xbe_x87_cos(double x) {
+    if (!X87Reduces(x)) return olm_cos(x);
+    double s, c;
+    X87SinCosPi66(x, &s, &c);
+    return c;
+}
+
+void xbe_x87_sincos(double x, double* s, double* c) {
+    if (!X87Reduces(x)) {
+        *s = olm_sin(x);
+        *c = olm_cos(x);
+        return;
+    }
+    X87SinCosPi66(x, s, c);
+}
+
+double xbe_x87_tan(double x) {
+    if (!X87Reduces(x)) return olm_tan(x);
+    double s, c;
+    X87SinCosPi66(x, &s, &c);
+    return s / c;
+}
+
+double xbe_round24(double x) {
+    double ax = std::fabs(x);
+    // Inside the finite float range a cast rounds to 24 bits, including subnormals.
+    if ((ax <= 0x1.fffffep+127 && ax >= 0x1p-126) || ax == 0.0 || x != x || ax == kInf)
+        return (double)(float)x;
+    int e = 0;
+    double m = xbe_frexp(x, &e);
+    return xbe_ldexp((double)(float)m, e);
+}
+
+int32_t xbe_cvt_i32(double rounded) {
+    if (!(rounded >= -2147483648.0 && rounded <= 2147483647.0)) return (int32_t)0x80000000u;
+    return (int32_t)(int64_t)rounded;
+}
+
+int xbe_trunc_i32(double v) {
+    if (!std::isfinite(v)) return std::signbit(v) ? -4096 : 4096;
+    double t = std::trunc(v);
+    if (t > 4096.0) return 4096;
+    if (t < -4096.0) return -4096;
+    return (int)(int64_t)t;
+}
+
+double xbe_ldexp(double v, int exp) {
+    if (v == 0.0 || IsNan(v) || IsInf(v)) return v;
+    uint64_t u = BitsOf(v);
+    int e = int((u >> 52) & 0x7ff);
+    uint64_t frac = u & 0x000fffffffffffffull;
+    uint64_t sign = u & 0x8000000000000000ull;
+    uint64_t sig53;
+    int E;
+    if (e == 0) {
+        if (frac == 0) return Bits(sign);
+        int sh = 0;
+        uint64_t t = frac;
+        while ((t & 0x0010000000000000ull) == 0) {
+            t <<= 1;
+            sh++;
+        }
+        sig53 = t;
+        E = -1022 - sh;
+    } else {
+        sig53 = frac | 0x0010000000000000ull;
+        E = e - 1023;
+    }
+    long long ne = (long long)E + (long long)exp;
+    if (ne >= 1024) return Copysign(kInf, v);
+    if (ne >= -1022) return Bits(sign | (uint64_t(ne + 1023) << 52) | (sig53 & 0x000fffffffffffffull));
+    if (ne <= -1022 - 64) return Copysign(0.0, v);
+    int shift = -1022 - int(ne);
+    if (shift >= 64) return Copysign(0.0, v);
+    uint64_t out = sig53 >> shift;
+    uint64_t round = (sig53 >> (shift - 1)) & 1ull;
+    uint64_t sticky = (shift > 1) && (sig53 & ((1ull << (shift - 1)) - 1ull)) != 0;
+    if (round && (sticky || (out & 1ull))) out += 1;
+    if (out >= 0x0010000000000000ull) return Bits(sign | (1ull << 52));
+    return Bits(sign | out);
+}
+
+double xbe_frexp(double v, int* exp) {
+    if (exp == nullptr) return v;
+    if (v == 0.0) {
+        *exp = 0;
+        return v;
+    }
+    if (IsNan(v) || IsInf(v)) {
+        *exp = 0;
+        return v;
+    }
+    uint64_t u = BitsOf(v);
+    int e = int((u >> 52) & 0x7ff);
+    uint64_t sign = u & 0x8000000000000000ull;
+    uint64_t sig = u & 0x000fffffffffffffull;
+    if (e == 0) {
+        int sh = 0;
+        while ((sig & 0x0010000000000000ull) == 0) {
+            sig <<= 1;
+            sh++;
+        }
+        sig &= 0x000fffffffffffffull;
+        *exp = -1021 - sh;
+        return Bits(sign | (uint64_t(1022) << 52) | sig);
+    }
+    *exp = e - 1022;
+    return Bits(sign | (uint64_t(1022) << 52) | sig);
+}
+
+double xbe_load80(const uint8_t* p) {
+    uint64_t mant;
+    uint16_t se;
+    std::memcpy(&mant, p, 8);
+    std::memcpy(&se, p + 8, 2);
+    uint64_t sign = uint64_t(se >> 15) << 63;
+    int exp = se & 0x7fff;
+    if (exp == 0x7fff) {
+        if ((mant << 1) == 0) return Bits(sign | 0x7ff0000000000000ull);
+        return Bits(sign | 0x7ff8000000000000ull);
+    }
+    if (mant == 0) return Bits(sign);
+    int shift = 0;
+    if ((mant & 0x8000000000000000ull) == 0) shift = Normalize80(mant);
+    int unbiased = (exp == 0 ? -16382 : exp - 16383) - shift;
+    uint64_t frac = (mant >> 11) & 0x000fffffffffffffull;
+    uint64_t round = (mant >> 10) & 1ull;
+    uint64_t sticky = (mant & 0x3ffull) != 0;
+    if (round && (sticky || (frac & 1ull))) {
+        frac += 1;
+        if (frac == 0x0010000000000000ull) {
+            frac = 0;
+            unbiased += 1;
+        }
+    }
+    if (unbiased >= 1024) return Bits(sign | 0x7ff0000000000000ull);
+    if (unbiased <= -1023) {
+        int sh = -1022 - unbiased;
+        uint64_t full = frac | 0x0010000000000000ull;
+        if (sh >= 54) return Bits(sign);
+        uint64_t out = full >> sh;
+        uint64_t rbit = (full >> (sh - 1)) & 1ull;
+        uint64_t st = (sh >= 2) && (full & ((1ull << (sh - 1)) - 1ull)) != 0;
+        if (rbit && (st || (out & 1ull))) out += 1;
+        if (out >= 0x0010000000000000ull) return Bits(sign | (1ull << 52));
+        return Bits(sign | out);
+    }
+    return Bits(sign | (uint64_t(unbiased + 1023) << 52) | frac);
+}
+
+void xbe_store80(uint8_t* p, double v) {
+    uint64_t u = BitsOf(v);
+    uint64_t sign = u >> 63;
+    int exp = int((u >> 52) & 0x7ff);
+    uint64_t frac = u & 0x000fffffffffffffull;
+    uint64_t mant = 0;
+    uint16_t se = uint16_t(sign << 15);
+    if (exp == 0x7ff) {
+        se |= 0x7fff;
+        mant = frac ? 0xC000000000000000ull : 0x8000000000000000ull;
+    } else if (exp == 0) {
+        if (frac != 0) {
+            uint64_t m = frac;
+            int sh = 0;
+            while ((m & 0x8000000000000000ull) == 0) {
+                m <<= 1;
+                sh++;
+            }
+            mant = m;
+            // bit 0 of frac has weight 2^-1074. After the shift, bit 63 has
+            // weight 2^(-1074 + 63 - sh) = 2^(-1011 - sh).
+            se |= uint16_t(16383 - 1011 - sh);
+        }
+    } else {
+        mant = (1ull << 63) | (frac << 11);
+        se |= uint16_t(exp + 15360);
+    }
+    std::memcpy(p, &mant, 8);
+    std::memcpy(p + 8, &se, 2);
+}
+
+void xbe_arm_host_fp() {
+#if defined(__aarch64__)
+    uint64_t fpcr = 0;
+    __asm__ volatile("msr fpcr, %0" ::"r"(fpcr));
+#elif defined(__x86_64__) || defined(_M_X64)
+#if defined(_MSC_VER) && !defined(__clang__)
+    _mm_setcsr(0x1F80);
+#else
+    uint32_t mxcsr = 0x1F80;
+    __asm__ volatile("ldmxcsr %0" ::"m"(mxcsr));
+#endif
+#endif
+}
+
+namespace {
+struct ArmMain {
+    ArmMain() { xbe_arm_host_fp(); }
+};
+ArmMain g_arm_main;
+}  // namespace
