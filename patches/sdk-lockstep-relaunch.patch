+std::string WideToUtf8(const wchar_t* w) {
+    if (!w || !w[0]) return {};
+    int n = WideCharToMultiByte(CP_UTF8, 0, w, -1, nullptr, 0, nullptr, nullptr);
+    if (n <= 1) return {};
+    std::string s(static_cast<size_t>(n - 1), '\0');
+    if (WideCharToMultiByte(CP_UTF8, 0, w, -1, s.data(), n, nullptr, nullptr) <= 0) return {};
+    return s;
+}
+
+std::wstring Utf8ToWide(const char* s) {
+    if (!s || !s[0]) return {};
+    int n = MultiByteToWideChar(CP_UTF8, 0, s, -1, nullptr, 0);
+    if (n <= 1) return {};
+    std::wstring w(static_cast<size_t>(n - 1), L'\0');
+    if (MultiByteToWideChar(CP_UTF8, 0, s, -1, w.data(), n) <= 0) return {};
+    return w;
+}
+
+// CreateProcess parses the command line with the CommandLineToArgvW rules.
+std::wstring QuoteArg(const std::wstring& arg) {
+    if (!arg.empty() && arg.find_first_of(L" \t\n\v\"") == std::wstring::npos) return arg;
+    std::wstring out = L"\"";
+    size_t bs = 0;
+    for (size_t i = 0;; i++) {
+        if (i == arg.size()) {
+            out.append(bs * 2, L'\\');
+            break;
+        }
+        wchar_t c = arg[i];
+        if (c == L'\\') {
+            bs++;
+            continue;
+        }
+        out.append(c == L'"' ? bs * 2 + 1 : bs, L'\\');
+        bs = 0;
+        out.push_back(c);
+    }
+    out.push_back(L'"');
+    return out;
+}
+
+bool SpawnReplaced(const char* exe, char* const* argv, void*) {
+    std::wstring app = Utf8ToWide(exe);
+    if (app.empty() || !argv) return false;
+    std::wstring cmd;
+    for (int i = 0; argv[i]; i++) {
+        if (i) cmd.push_back(L' ');
+        cmd += QuoteArg(Utf8ToWide(argv[i]));
+    }
+    std::vector<wchar_t> buf(cmd.begin(), cmd.end());
+    buf.push_back(L'\0');
+    STARTUPINFOW si{};
+    si.cb = sizeof si;
+    PROCESS_INFORMATION pi{};
+    // NULL environment inherits this process, including FUZION_RELAY_CODE / FUZION_RELAY.
+    if (!CreateProcessW(app.c_str(), buf.data(), nullptr, nullptr, FALSE, 0, nullptr, nullptr, &si, &pi))
+        return false;
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    ExitProcess(0);
+    return true;
+}
+
+}  // namespace
+
+bool RestartOnline(const char* code, const char* relay) {
+    std::wstring exe(32768, L'\0');
+    DWORD n = GetModuleFileNameW(nullptr, exe.data(), static_cast<DWORD>(exe.size()));
+    if (n == 0 || n >= exe.size()) return false;
+    exe.resize(n);
+    int argc = 0;
+    LPWSTR* wargv = CommandLineToArgvW(GetCommandLineW(), &argc);
+    if (!wargv || argc < 1) {
+        if (wargv) LocalFree(wargv);
+        return false;
+    }
+    std::string exe_utf8 = WideToUtf8(exe.c_str());
+    std::vector<std::string> owned;
+    owned.reserve(static_cast<size_t>(argc));
+    for (int i = 0; i < argc; i++) owned.push_back(WideToUtf8(wargv[i]));
+    LocalFree(wargv);
+    if (exe_utf8.empty()) return false;
+    std::vector<char*> argv;
+    argv.reserve(owned.size());
+    for (std::string& s : owned) argv.push_back(s.data());
+    return play::RestartOnline(code, relay, argc, argv.data(), exe_utf8.c_str(), SpawnReplaced, nullptr);
+}
