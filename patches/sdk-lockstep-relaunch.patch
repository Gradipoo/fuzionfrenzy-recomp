+bool RestartOnline(const char* code, const char* relay) {
+    if (code && code[0]) setenv("FUZION_RELAY_CODE", code, 1);
+    else unsetenv("FUZION_RELAY_CODE");
+    if (relay && relay[0]) setenv("FUZION_RELAY", relay, 1);
+    static char flag[] = "--lockstep";
+    std::vector<char*> args;
+    args.reserve(size_t(g_argc) + 2);
+    bool has = false;
+    for (int i = 0; i < g_argc; i++) {
+        if (g_argv[i] && std::strcmp(g_argv[i], "--lockstep") == 0) has = true;
+        args.push_back(g_argv[i]);
+    }
+    if (!has) args.push_back(flag);
+    args.push_back(nullptr);
+    char path[4096];
+#if defined(__APPLE__)
+    uint32_t sz = sizeof path;
+    if (_NSGetExecutablePath(path, &sz) != 0) return false;
+    execv(path, args.data());
+#else
+    execv("/proc/self/exe", args.data());
+#endif
+    return false;
 }
 
